<script define:vars={{ calculatorData: calculator, benefitAmount: benefit.display, installmentMonths: prices.installmentMonths, metrikaId }}>
  // Данные калькулятора приходят из prices.json через define:vars — тот же
  // источник, что и разметка выше, никаких чисел не хардкодим в JS.
  const root = document.querySelector('.calculator');
  if (root) {
    const fmt = (n) => Math.round(n).toLocaleString('ru-RU') + ' ₽';

    const state = {
      base: calculatorData.defaults.base,
      coffin: calculatorData.defaults.coffin,
      extras: new Set(calculatorData.defaults.extras),
      guests: calculatorData.defaults.guests,
      privileges: calculatorData.defaults.privileges,
    };

    const findBase = (id) => calculatorData.base.find((b) => b.id === id);
    const findCoffin = (id) => calculatorData.coffins.find((c) => c.id === id);
    const findPrivilege = (id) => calculatorData.privileges.find((p) => p.id === id);
    const basePrice = (item) => item.pricePerKm ?? item.price ?? 0;
    const optionsWord = (n) => (n === 1 ? 'опция' : n < 5 ? 'опции' : 'опций');

    // ===== Пересчёт и рендер сметы =====

    const render = () => {
      const base = findBase(state.base);
      const coffin = findCoffin(state.coffin);
      const isFuneral = state.base === 'funeral';
      const extrasList = calculatorData.extras.filter((e) => state.extras.has(e.id));
      const extrasSum = extrasList.reduce((sum, e) => sum + e.price, 0);
      const coffinPrice = isFuneral ? coffin.price : 0;
      const coffinAndExtras = coffinPrice + extrasSum;
      const wakeSum = state.guests * calculatorData.wakePerGuest;
      const basePriceValue = basePrice(base);
      const privilege = findPrivilege(state.privileges);
      const privilegeDiscount = privilege?.discount ?? 0;
      const rawTotal = basePriceValue + coffinAndExtras + wakeSum - benefitAmount - privilegeDiscount;
      const total = Math.max(0, rawTotal);
      const installment = Math.round(total / installmentMonths);

      // --- Гроб только для «Похороны» ---
      const coffinGroup = root.querySelector('[data-coffin-group]');
      if (coffinGroup) coffinGroup.hidden = !isFuneral;

      // --- Итог ---
      const totalEl = root.querySelector('[data-total]');
      if (totalEl) totalEl.textContent = fmt(total);
      const installmentEl = root.querySelector('[data-installment]');
      if (installmentEl) installmentEl.textContent = `или ${fmt(installment)}/мес на ${installmentMonths} месяцев`;

      // --- Краткая смета ---
      const lineBase = root.querySelector('[data-line-base]');
      if (lineBase) lineBase.textContent = fmt(basePriceValue);

      const coffinLabel = root.querySelector('[data-line-coffin-label]');
      if (coffinLabel) {
        coffinLabel.textContent = isFuneral
          ? `Гроб и ${extrasList.length} ${optionsWord(extrasList.length)}`
          : `${extrasList.length} ${optionsWord(extrasList.length)}`;
      }
      const lineCoffin = root.querySelector('[data-line-coffin]');
      if (lineCoffin) lineCoffin.textContent = fmt(coffinAndExtras);

      const wakeRow = root.querySelector('[data-line-wake-row]');
      const lineWake = root.querySelector('[data-line-wake]');
      if (wakeRow) wakeRow.hidden = state.guests === 0;
      if (lineWake) lineWake.textContent = fmt(wakeSum);

      const privilegeRow = root.querySelector('[data-line-privilege-row]');
      const privilegeLabel = root.querySelector('[data-line-privilege-label]');
      const linePrivilege = root.querySelector('[data-line-privilege]');
      if (privilegeRow) privilegeRow.hidden = privilegeDiscount === 0;
      if (privilegeLabel) privilegeLabel.textContent = `Льгота «${privilege?.title ?? ''}»`;
      if (linePrivilege) linePrivilege.textContent = `−${fmt(privilegeDiscount)}`;

      // --- Полная смета (details) ---
      const fullEl = root.querySelector('[data-full-breakdown]');
      if (fullEl) {
        const rows = [[base.title, fmt(basePriceValue)]];
        if (isFuneral) rows.push([`Гроб «${coffin.title}»`, coffin.price === 0 ? (coffin.label ?? 'включено') : fmt(coffin.price)]);
        rows.push(...extrasList.map((e) => [e.title, fmt(e.price)]));
        if (state.guests > 0) rows.push([`Поминки, ${state.guests} гостей`, fmt(wakeSum)]);
        if (privilegeDiscount > 0) rows.push([`Льгота «${privilege?.title ?? ''}»`, `−${fmt(privilegeDiscount)}`]);
        fullEl.innerHTML = rows
          .map(([label, value]) => `<div class="calculator__summary-line"><p>${label}</p><p>${value}</p></div>`)
          .join('');
      }

      // --- Синхронизация desktop-контролов ---
      root.querySelectorAll('[data-base-id]').forEach((btn) => {
        btn.setAttribute('aria-checked', String(btn.dataset.baseId === state.base));
        btn.classList.toggle('calculator__base-item--active', btn.dataset.baseId === state.base);
      });
      root.querySelectorAll('[data-coffin-id]').forEach((btn) => {
        btn.setAttribute('aria-checked', String(btn.dataset.coffinId === state.coffin));
        btn.classList.toggle('calculator__coffin-item--active', btn.dataset.coffinId === state.coffin);
      });
      root.querySelectorAll('[data-extra-id]').forEach((input) => {
        const checked = state.extras.has(input.dataset.extraId);
        input.checked = checked;
        input.closest('.calculator__chip')?.classList.toggle('calculator__chip--active', checked);
      });
      // --- Синхронизация mobile-полей ---
      const privilegeTitleEl = root.querySelector('[data-privilege-title]');
      if (privilegeTitleEl) privilegeTitleEl.textContent = `Льготы: ${privilegeDiscount === 0 ? 'нет' : privilege?.title ?? ''}`;

      const baseTitleEl = root.querySelector('[data-base-title]');
      const baseSubtitleEl = root.querySelector('[data-base-subtitle]');
      const baseIconEl = root.querySelector('[data-base-icon]');
      if (baseTitleEl) baseTitleEl.textContent = base.title;
      if (baseSubtitleEl) baseSubtitleEl.textContent = base.pricePerKm ? `от ${base.pricePerKm} ₽/км` : `от ${fmt(base.price)}`;
      if (baseIconEl) baseIconEl.innerHTML = document.querySelector(`[data-sheet-base-option="${base.id}"] .calc-sheet__option-icon`)?.innerHTML ?? baseIconEl.innerHTML;

      const baseIncludesLabel = root.querySelector('[data-base-includes-label]');
      const baseIncludes = root.querySelector('[data-base-includes]');
      if (baseIncludesLabel) baseIncludesLabel.textContent = `В базе ${fmt(basePriceValue)}:`;
      if (baseIncludes) baseIncludes.textContent = base.includes ?? '';
      const noteEl = root.querySelector('.calculator__note');
      if (noteEl) noteEl.style.display = base.includes ? '' : 'none';

      const coffinTitleEl = root.querySelector('[data-coffin-title]');
      const coffinSubtitleEl = root.querySelector('[data-coffin-subtitle]');
      const coffinPriceEl = root.querySelector('[data-coffin-price]');
      if (coffinTitleEl) coffinTitleEl.textContent = coffin.title;
      if (coffinSubtitleEl) coffinSubtitleEl.textContent = coffin.description;
      if (coffinPriceEl) coffinPriceEl.textContent = coffin.price === 0 ? (coffin.label ?? 'включено') : `+${fmt(coffin.price)}`;

      const extrasTitleEl = root.querySelector('[data-extras-title]');
      const extrasSubtitleEl = root.querySelector('[data-extras-subtitle]');
      const extrasPriceEl = root.querySelector('[data-extras-price]');
      const extrasCountEl = root.querySelector('[data-extras-count]');
      if (extrasTitleEl) extrasTitleEl.textContent = extrasList.length ? `Выбрано ${extrasList.length} ${extrasList.length === 1 ? 'услуга' : 'услуги'}` : 'Ничего не выбрано';
      if (extrasSubtitleEl) extrasSubtitleEl.textContent = extrasList.map((e) => e.title).join(', ');
      if (extrasPriceEl) extrasPriceEl.textContent = extrasSum ? `+${fmt(extrasSum)}` : '';
      if (extrasCountEl) extrasCountEl.textContent = `выбрано ${extrasList.length}`;

      const guestsValueEl = root.querySelector('[data-guests-value]');
      if (guestsValueEl) guestsValueEl.textContent = String(state.guests);

      // --- Синхронизация шторок ---
      root.querySelectorAll('[data-sheet-base-option]').forEach((btn) => {
        btn.setAttribute('aria-checked', String(btn.dataset.sheetBaseOption === state.base));
      });
      root.querySelectorAll('[data-sheet-coffin-option]').forEach((btn) => {
        btn.setAttribute('aria-checked', String(btn.dataset.sheetCoffinOption === state.coffin));
      });
      root.querySelectorAll('[data-sheet-privilege-option]').forEach((btn) => {
        btn.setAttribute('aria-checked', String(btn.dataset.sheetPrivilegeOption === state.privileges));
      });
      root.querySelectorAll('[data-privilege-option]').forEach((btn) => {
        btn.setAttribute('aria-selected', String(btn.dataset.privilegeOption === state.privileges));
      });
      root.querySelectorAll('[data-sheet-extra-option]').forEach((input) => {
        input.checked = state.extras.has(input.dataset.sheetExtraOption);
      });
      const sheetExtrasSum = root.querySelector('[data-sheet-extras-sum]');
      if (sheetExtrasSum) sheetExtrasSum.textContent = extrasSum ? `· +${fmt(extrasSum)}` : '';
    };

    // ===== Обработчики: desktop =====

    root.querySelectorAll('[data-base-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.base = btn.dataset.baseId;
        render();
        trackCalcUsed();
      });
    });

    root.querySelectorAll('[data-coffin-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.coffin = btn.dataset.coffinId;
        render();
        trackCalcUsed();
      });
    });

    root.querySelectorAll('[data-extra-id]').forEach((input) => {
      input.addEventListener('change', () => {
        if (input.checked) state.extras.add(input.dataset.extraId);
        else state.extras.delete(input.dataset.extraId);
        render();
        trackCalcUsed();
      });
    });

    const guestsDecrement = root.querySelector('[data-guests-decrement]');
    const guestsIncrement = root.querySelector('[data-guests-increment]');
    guestsDecrement?.addEventListener('click', () => {
      state.guests = Math.max(0, state.guests - 1);
      render();
      trackCalcUsed();
    });
    guestsIncrement?.addEventListener('click', () => {
      state.guests = state.guests + 1;
      render();
      trackCalcUsed();
    });

    // ===== Обработчики: шторки (mobile + «Льготы» на всех шириных) =====

    const sheets = {
      base: root.querySelector('[data-sheet="base"]'),
      coffin: root.querySelector('[data-sheet="coffin"]'),
      extras: root.querySelector('[data-sheet="extras"]'),
      privileges: root.querySelector('[data-sheet="privileges"]'),
    };

    const openSheet = (name) => {
      const dialog = sheets[name];
      if (!dialog || typeof dialog.showModal !== 'function') return;
      dialog.showModal();
      document.body.style.overflow = 'hidden';
    };

    const closeSheet = (dialog) => {
      dialog.close();
      document.body.style.overflow = '';
    };

    // Плавное закрытие — шторка уезжает вниз тем же переходом, что и при
    // отпущенном свайпе за порогом (см. enableSwipeToClose ниже). Нужно
    // везде, где шторку закрывает не палец пользователя, а клик: выбор
    // опции, кнопка «Готово», тап по фону, Esc — иначе dialog.close()
    // скрывает её мгновенно, без анимации.
    const closeSheetAnimated = (dialog) => {
      if (!dialog.open) return;
      dialog.style.transition = 'transform 0.25s ease';
      dialog.style.transform = 'translateY(100%)';
      dialog.addEventListener('transitionend', function onEnd() {
        dialog.removeEventListener('transitionend', onEnd);
        dialog.style.transition = '';
        dialog.style.transform = '';
        closeSheet(dialog);
      }, { once: true });
    };

    // "Льготы" — на mobile та же шторка снизу, что у остальных полей;
    // на desktop (где у поля нет отдельной сетки-альтернативы) — лёгкое
    // выпадающее меню под полем, а не шторка на всю ширину экрана.
    const isDesktop = () => window.matchMedia('(min-width: 1024px)').matches;
    const privilegesWrap = root.querySelector('.calculator__privileges-wrap');
    const privilegesToggle = root.querySelector('[data-privileges-toggle]');
    const privilegesMenu = root.querySelector('[data-privileges-menu]');

    const closePrivilegesMenu = () => {
      if (privilegesMenu) privilegesMenu.hidden = true;
      privilegesToggle?.setAttribute('aria-expanded', 'false');
    };

    privilegesToggle?.addEventListener('click', () => {
      if (!isDesktop()) {
        openSheet('privileges');
        return;
      }
      if (!privilegesMenu) return;
      const willOpen = privilegesMenu.hidden;
      closePrivilegesMenu();
      if (willOpen) {
        privilegesMenu.hidden = false;
        privilegesToggle.setAttribute('aria-expanded', 'true');
      }
    });

    document.addEventListener('click', (event) => {
      if (privilegesWrap && !privilegesWrap.contains(event.target)) closePrivilegesMenu();
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') closePrivilegesMenu();
    });

    privilegesMenu?.querySelectorAll('[data-privilege-option]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.privileges = btn.dataset.privilegeOption;
        render();
        trackCalcUsed();
        closePrivilegesMenu();
      });
    });

    root.querySelectorAll('[data-open-sheet]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.disabled) return;
        openSheet(btn.dataset.openSheet);
      });
    });

    Object.values(sheets).forEach((dialog) => {
      if (!dialog) return;

      // Кнопка "Готово" (есть только у шторки "Дополнительно" — у
      // остальных крестика/кнопки закрытия нет, закрываются свайпом,
      // выбором опции, тапом по фону или Esc)
      dialog.querySelectorAll('[data-close-sheet]').forEach((btn) => {
        btn.addEventListener('click', () => closeSheetAnimated(dialog));
      });

      // Клик по backdrop (тап вне контента шторки закрывает её)
      dialog.addEventListener('click', (event) => {
        if (event.target === dialog) closeSheetAnimated(dialog);
      });

      // Esc — тоже плавно, вместо мгновенного нативного закрытия
      dialog.addEventListener('cancel', (event) => {
        event.preventDefault();
        closeSheetAnimated(dialog);
      });

      // Любой способ закрытия <dialog> — снимаем блокировку скролла
      dialog.addEventListener('close', () => {
        document.body.style.overflow = '';
      });
    });

    // Свайп вниз по любой открытой области шторки — плавно закрывает её.
    // Дальше трети высоты шторки — доезжает вниз и закрывается, иначе
    // пружинит обратно на место. Список опций при этом сохраняет обычный
    // скролл: жест на закрытие начинается, только если в момент касания
    // список уже проскроллен к самому верху (dialog.scrollTop <= 0).
    //
    // Пришлось взять нативные touch-события вместо Pointer Events (как в
    // остальных местах сайта): на реальном тачскрине браузер распознаёт
    // вертикальный драг по скроллящемуся элементу как жест скролла и
    // присылает pointercancel уже после первого pointermove — дальше
    // приходят только touchmove, pointermove/pointerup больше не долетают.
    // preventDefault в non-passive touchmove — единственный надёжный
    // способ забрать жест под себя (проверено эмуляцией тача в браузере).
    const enableSwipeToClose = (dialog) => {
      let startY = 0;
      let offset = 0;
      let dragging = false;

      const getY = (event) => (event.touches?.[0] ?? event).clientY;

      const onMove = (event) => {
        if (!dragging) return;
        offset = Math.max(0, getY(event) - startY);
        if (offset > 0 && event.cancelable) event.preventDefault();
        dialog.style.transform = `translateY(${offset}px)`;
      };

      const endDrag = () => {
        if (!dragging) return;
        dragging = false;
        window.removeEventListener('touchmove', onMove);
        window.removeEventListener('touchend', endDrag);
        window.removeEventListener('touchcancel', endDrag);
        window.removeEventListener('mousemove', onMove);
        window.removeEventListener('mouseup', endDrag);

        if (offset > dialog.offsetHeight * 0.25) {
          closeSheetAnimated(dialog);
        } else if (offset > 0) {
          dialog.style.transition = 'transform 0.2s ease';
          dialog.style.transform = '';
          dialog.addEventListener('transitionend', function onEnd() {
            dialog.removeEventListener('transitionend', onEnd);
            dialog.style.transition = '';
          }, { once: true });
        }
        offset = 0;
      };

      const onStart = (event) => {
        if (event.type === 'mousedown' && event.button !== 0) return;
        if (dialog.scrollTop > 0) return;
        dragging = true;
        startY = getY(event);
        offset = 0;
        dialog.style.transition = '';
        if (event.type === 'touchstart') {
          window.addEventListener('touchmove', onMove, { passive: false });
          window.addEventListener('touchend', endDrag);
          window.addEventListener('touchcancel', endDrag);
        } else {
          window.addEventListener('mousemove', onMove);
          window.addEventListener('mouseup', endDrag);
        }
      };

      dialog.addEventListener('touchstart', onStart);
      dialog.addEventListener('mousedown', onStart);
    };

    Object.values(sheets).forEach((dialog) => {
      if (dialog) enableSwipeToClose(dialog);
    });

    // "Что нужно" — одиночный выбор, закрывается сразу после выбора
    sheets.base?.querySelectorAll('[data-sheet-base-option]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.base = btn.dataset.sheetBaseOption;
        render();
        trackCalcUsed();
        closeSheetAnimated(sheets.base);
      });
    });

    // "Гроб" — одиночный выбор, закрывается сразу после выбора
    sheets.coffin?.querySelectorAll('[data-sheet-coffin-option]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.coffin = btn.dataset.sheetCoffinOption;
        render();
        trackCalcUsed();
        closeSheetAnimated(sheets.coffin);
      });
    });

    // "Льготы" — одиночный выбор, закрывается сразу после выбора
    sheets.privileges?.querySelectorAll('[data-sheet-privilege-option]').forEach((btn) => {
      btn.addEventListener('click', () => {
        state.privileges = btn.dataset.sheetPrivilegeOption;
        render();
        trackCalcUsed();
        closeSheetAnimated(sheets.privileges);
      });
    });

    // "Дополнительно" — чекбоксы, закрывается только по "Готово"/крестику
    sheets.extras?.querySelectorAll('[data-sheet-extra-option]').forEach((input) => {
      input.addEventListener('change', () => {
        if (input.checked) state.extras.add(input.dataset.sheetExtraOption);
        else state.extras.delete(input.dataset.sheetExtraOption);
        render();
        trackCalcUsed();
      });
    });

    // ===== Метрика (цель calc_used — не чаще раза в сессии) =====

    let calcUsedTracked = false;
    function trackCalcUsed() {
      if (calcUsedTracked || !metrikaId) return;
      calcUsedTracked = true;
      window.ym?.(metrikaId, 'reachGoal', 'calc_used');
    }

    // ===== Кнопка "Зафиксировать смету" =====
    // TODO: секция Contact (заявка) ещё не сверстана — по правилу
    // "форма заявки со сметой" пока временная заглушка. Когда появится
    // форма, заменить на открытие модалки/скролл к #contact с передачей
    // сметы (base/coffin/extras/guests/total из state выше).
    const fixButton = root.querySelector('[data-fix-estimate]');
    fixButton?.addEventListener('click', () => {
      window.alert('Форма заявки скоро появится здесь. Пока позвоните нам — смету обсудим по телефону.');
    });

    // ===== PDF (заглушка) =====
    const pdfButton = root.querySelector('[data-download-pdf]');
    pdfButton?.addEventListener('click', () => {
      window.alert('Формирование сметы в PDF — скоро будет доступно. Пока смету можно передать агенту по телефону.');
    });

    render();
  }
</script>
