---
// 08 · Calculator — Калькулятор стоимости. Desktop 198:3056, mobile 214:4118.
// Desktop: форма (белая, слева) и смета (тёмная, справа) — видны сразу,
// опции — чипы/карточки в самой форме.
// Mobile: форма и смета — один блок без зазора (белая часть сверху, тёмная
// снизу). «Что нужно», «Гроб», «Дополнительно» — поля-селекты, открывают
// шторку снизу (<dialog>). Шторки see rai-handoff.md 5a (235:4133, 235:4178, 235:4205).
// Весь пересчёт — на клиенте (<script> в конце файла), данные — только из prices.json.
import Icon from '@components/Icon.astro';
import Button from '@components/Button.astro';
import prices from '@data/prices.json';

const { calculator, benefit } = prices;
// Для цели calc_used (см. CLAUDE.md → Аналитика) — тот же способ подключения,
// что и в Base.astro.
const metrikaId = import.meta.env.PUBLIC_YANDEX_METRIKA_ID ?? null;

// Значения по умолчанию для начального рендера полей-селектов (mobile) —
// берём явно по id из defaults, а не по индексу массива.
const defaultBase = calculator.base.find((b) => b.id === calculator.defaults.base) ?? calculator.base[0];
const defaultCoffin = calculator.coffins.find((c) => c.id === calculator.defaults.coffin) ?? calculator.coffins[0];
const defaultPrivilege = calculator.privileges.find((p) => p.id === calculator.defaults.privileges) ?? calculator.privileges[0];
const defaultBasePrice = (item: typeof defaultBase) => item.pricePerKm ? `от ${item.pricePerKm} ₽/км` : `от ${(item.price ?? 0).toLocaleString('ru-RU')} ₽`;
---

<section id="calculator" aria-labelledby="calculator-title" class="section calculator">
  <div class="container calculator__inner">
    <div class="calculator__header">
      <div class="calculator__heading">
        <p class="eyebrow">Калькулятор стоимости</p>
        <h2 id="calculator-title" class="h2">
          Рассчитайте стоимость <em>за минуту</em>
        </h2>
      </div>
      <p class="body-m calculator__lead">
        Наведите на «i», чтобы узнать, что входит в опцию. Пособие учтено автоматически.
      </p>
    </div>

    <div class="calculator__body">
      <!-- ===== Форма ===== -->
      <div class="calculator__form">
        <!-- Что нужно -->
        <div class="calculator__group">
          <p class="label-m calculator__group-title">Что нужно</p>

          <!-- Desktop: карточки-кнопки в ряд -->
          <div class="calculator__base-grid" role="radiogroup" aria-label="Что нужно">
            {calculator.base.map((item) => (
              <button
                type="button"
                role="radio"
                aria-checked={item.id === calculator.defaults.base ? 'true' : 'false'}
                data-base-id={item.id}
                class:list={['calculator__base-item', { 'calculator__base-item--active': item.id === calculator.defaults.base }]}
              >
                <span class="calculator__base-icon" aria-hidden="true">
                  <Icon name={item.icon} size={18} />
                </span>
                <span class="calculator__base-text">
                  <span class="label-m calculator__base-title">{item.title}</span>
                  <span class="body-s calculator__base-price">{defaultBasePrice(item)}</span>
                </span>
              </button>
            ))}
          </div>

          <!-- Mobile: поле-селект, открывает шторку -->
          <button type="button" class="calculator__field" data-open-sheet="base" aria-haspopup="dialog">
            <span class="calculator__field-icon" aria-hidden="true" data-base-icon>
              <Icon name={defaultBase.icon} size={18} />
            </span>
            <span class="calculator__field-text">
              <span class="label-m calculator__field-title" data-base-title>{defaultBase.title}</span>
              <span class="body-s calculator__field-subtitle" data-base-subtitle>{defaultBasePrice(defaultBase)}</span>
            </span>
            <Icon name="chevron" size={18} class="calculator__field-chevron" />
          </button>
        </div>

        <!-- В базе: ... -->
        <div class="calculator__note">
          <Icon name="check" size={16} class="calculator__note-icon" />
          <p class="body-s calculator__note-text">
            <span class="calculator__note-label" data-base-includes-label>В базе {(defaultBase.price ?? 0).toLocaleString('ru-RU')} ₽:</span>{' '}
            <span data-base-includes>{defaultBase.includes}</span>
          </p>
        </div>

        <!-- Гроб — только для «Похороны», см. <script> внизу -->
        <div class="calculator__group" data-coffin-group>
          <div class="calculator__group-head">
            <p class="label-m calculator__group-title">Гроб</p>
            <a href="#pricing" class="body-s calculator__group-link">выбрать в каталоге →</a>
          </div>

          <!-- Desktop: три карточки -->
          <div class="calculator__coffin-grid" role="radiogroup" aria-label="Гроб">
            {calculator.coffins.map((coffin) => (
              <button
                type="button"
                role="radio"
                aria-checked={coffin.id === calculator.defaults.coffin ? 'true' : 'false'}
                data-coffin-id={coffin.id}
                class:list={['calculator__coffin-item', { 'calculator__coffin-item--active': coffin.id === calculator.defaults.coffin }]}
              >
                <span class="calculator__coffin-row">
                  <span class="label-m calculator__coffin-title">{coffin.title}</span>
                  <span class="body-s calculator__coffin-price">{coffin.price === 0 ? (coffin.label ?? 'включено') : `+${coffin.price.toLocaleString('ru-RU')} ₽`}</span>
                </span>
                <span class="body-s calculator__coffin-desc">{coffin.description}</span>
              </button>
            ))}
          </div>

          <!-- Mobile: поле-селект -->
          <button type="button" class="calculator__field" data-open-sheet="coffin" aria-haspopup="dialog">
            <span class="calculator__field-text">
              <span class="label-m calculator__field-title" data-coffin-title>{defaultCoffin.title}</span>
              <span class="body-s calculator__field-subtitle" data-coffin-subtitle>{defaultCoffin.description}</span>
            </span>
            <span class="body-s-strong calculator__field-price" data-coffin-price></span>
            <Icon name="chevron" size={18} class="calculator__field-chevron" />
          </button>
        </div>

        <!-- Дополнительно -->
        <div class="calculator__group">
          <div class="calculator__group-head">
            <p class="label-m calculator__group-title">Дополнительно</p>
            <p class="body-s calculator__group-count" data-extras-count>выбрано {calculator.defaults.extras.length}</p>
          </div>

          <!-- Desktop: чипы 2 в ряд -->
          <div class="calculator__extras-grid">
            {calculator.extras.map((extra) => {
              const checked = calculator.defaults.extras.includes(extra.id);
              return (
                <label class:list={['calculator__chip', { 'calculator__chip--active': checked }]}>
                  <input type="checkbox" class="calculator__chip-input" data-extra-id={extra.id} checked={checked} />
                  <span class="calculator__chip-box" aria-hidden="true">
                    <Icon name="check" size={12} class="calculator__chip-check" />
                  </span>
                  <span class="body-m calculator__chip-label">{extra.title}</span>
                  <span class="calculator__chip-info" tabindex="0" aria-label={extra.hint}>
                    <Icon name="info" size={16} />
                    <span class="calculator__chip-tooltip" role="tooltip" aria-hidden="true">{extra.hint}</span>
                  </span>
                  <span class="body-s calculator__chip-price">{extra.price === 0 ? '0 ₽' : `+${extra.price.toLocaleString('ru-RU')} ₽`}</span>
                </label>
              );
            })}
          </div>

          <!-- Mobile: поле-селект -->
          <button type="button" class="calculator__field" data-open-sheet="extras" aria-haspopup="dialog">
            <span class="calculator__field-text">
              <span class="label-m calculator__field-title" data-extras-title>Выбрано {calculator.defaults.extras.length} услуги</span>
              <span class="body-s calculator__field-subtitle" data-extras-subtitle></span>
            </span>
            <span class="body-s-strong calculator__field-price" data-extras-price></span>
            <Icon name="chevron" size={18} class="calculator__field-chevron" />
          </button>
        </div>

        <!-- Поминки + Льготы -->
        <div class="calculator__row">
          <div class="calculator__stepper">
            <p class="body-m calculator__stepper-label">Поминки, {calculator.wakePerGuest.toLocaleString('ru-RU')} ₽/гость</p>
            <div class="calculator__stepper-control">
              <button type="button" class="calculator__stepper-btn" data-guests-decrement aria-label="Уменьшить число гостей">−</button>
              <span class="label-m calculator__stepper-value" data-guests-value aria-live="polite">{calculator.defaults.guests}</span>
              <button type="button" class="calculator__stepper-btn" data-guests-increment aria-label="Увеличить число гостей">+</button>
            </div>
          </div>

          <!-- Mobile — открывает шторку снизу (как «Что нужно»/«Гроб»); desktop —
               выпадающее меню под полем, см. data-privileges-toggle в <script> -->
          <div class="calculator__privileges-wrap">
            <button type="button" class="calculator__field calculator__field--privileges" data-privileges-toggle aria-haspopup="listbox" aria-expanded="false">
              <span class="body-m calculator__field-privileges-text" data-privilege-title>
                Льготы: {defaultPrivilege.discount === 0 ? 'нет' : defaultPrivilege.title}
              </span>
              <Icon name="chevron" size={18} class="calculator__field-chevron" />
            </button>

            <div class="calculator__privileges-menu" role="listbox" aria-label="Льготы" data-privileges-menu hidden>
              {calculator.privileges.map((privilege) => (
                <button
                  type="button"
                  role="option"
                  aria-selected={privilege.id === calculator.defaults.privileges ? 'true' : 'false'}
                  data-privilege-option={privilege.id}
                  class="calculator__privileges-option"
                >
                  <span class="body-m calculator__privileges-option-title">{privilege.title}</span>
                  <span class="body-s-strong calculator__privileges-option-price">{privilege.discount === 0 ? '—' : `−${privilege.discount.toLocaleString('ru-RU')} ₽`}</span>
                  <Icon name="check" size={16} class="calculator__privileges-option-check" />
                </button>
              ))}
            </div>
          </div>
        </div>
      </div>

      <!-- ===== Смета ===== -->
      <div class="calculator__summary">
        <p class="label-s calculator__summary-eyebrow">Итого с учётом пособия</p>
        <p class="num-l calculator__summary-total" data-total aria-live="polite">0 ₽</p>
        <p class="body-s calculator__summary-installment" data-installment>или 0 ₽/мес на {prices.installmentMonths} месяцев</p>

        <div class="calculator__summary-breakdown">
          <div class="calculator__summary-line">
            <p>Похороны под ключ</p>
            <p data-line-base>0 ₽</p>
          </div>
          <div class="calculator__summary-line">
            <p data-line-coffin-label>Гроб и опции</p>
            <p data-line-coffin>0 ₽</p>
          </div>
          <div class="calculator__summary-line calculator__summary-line--wake" data-line-wake-row hidden>
            <p>Поминки</p>
            <p data-line-wake>0 ₽</p>
          </div>
          <div class="calculator__summary-line calculator__summary-line--privilege" data-line-privilege-row hidden>
            <p data-line-privilege-label>Льгота</p>
            <p data-line-privilege>0 ₽</p>
          </div>
          <div class="calculator__summary-line calculator__summary-line--benefit">
            <p>Пособие на погребение</p>
            <p data-line-benefit>−{benefit.display.toLocaleString('ru-RU')} ₽</p>
          </div>
        </div>

        <details class="calculator__summary-details">
          <summary class="body-s calculator__summary-toggle">
            Показать всю смету
            <Icon name="chevron" size={16} class="calculator__summary-toggle-icon" />
          </summary>
          <div class="calculator__summary-full" data-full-breakdown></div>
        </details>

        <div class="calculator__summary-perks">
          <p class="body-s calculator__summary-perk">
            <Icon name="check" size={14} />
            Цена фиксируется в договоре
          </p>
          <p class="body-s calculator__summary-perk">
            <Icon name="check" size={14} />
            Без предоплаты и доплат
          </p>
        </div>

        <div class="calculator__summary-spacer" aria-hidden="true"></div>

        <Button type="button" variant="primary" size="m" icon="arrow" class="calculator__summary-cta" data-fix-estimate>
          Зафиксировать смету
        </Button>
        <button type="button" class="body-s calculator__summary-pdf" data-download-pdf>
          <Icon name="file" size={16} />
          Смета в PDF
        </button>
      </div>
    </div>
  </div>

  <!-- ===== Mobile: шторки (bottom sheet) ===== -->

  <dialog class="calc-sheet" data-sheet="base" aria-labelledby="sheet-base-title">
    <div class="calc-sheet__handle" aria-hidden="true"></div>
    <div class="calc-sheet__head">
      <p id="sheet-base-title" class="h4 calc-sheet__title">Что нужно?</p>
    </div>
    <div class="calc-sheet__list" role="radiogroup" aria-label="Что нужно">
      {calculator.base.map((item) => (
        <button type="button" role="radio" aria-checked="false" data-sheet-base-option={item.id} class="calc-sheet__option">
          <span class="calc-sheet__option-icon" aria-hidden="true">
            <Icon name={item.icon} size={18} />
          </span>
          <span class="calc-sheet__option-text">
            <span class="label-m">{item.title}</span>
            <span class="body-s calc-sheet__option-note">{defaultBasePrice(item)}</span>
          </span>
          <Icon name="check" size={18} class="calc-sheet__option-check" />
        </button>
      ))}
    </div>
  </dialog>

  <dialog class="calc-sheet" data-sheet="coffin" aria-labelledby="sheet-coffin-title">
    <div class="calc-sheet__handle" aria-hidden="true"></div>
    <div class="calc-sheet__head">
      <p id="sheet-coffin-title" class="h4 calc-sheet__title">Гроб</p>
    </div>
    <div class="calc-sheet__list" role="radiogroup" aria-label="Гроб">
      {calculator.coffins.map((coffin) => (
        <button type="button" role="radio" aria-checked="false" data-sheet-coffin-option={coffin.id} class="calc-sheet__option calc-sheet__option--coffin">
          <span class="calc-sheet__option-text">
            <span class="label-m">{coffin.title}</span>
            <span class="body-s calc-sheet__option-note">{coffin.description}</span>
          </span>
          <span class="body-s-strong calc-sheet__option-price">{coffin.price === 0 ? (coffin.label ?? 'включено') : `+${coffin.price.toLocaleString('ru-RU')} ₽`}</span>
          <Icon name="check" size={18} class="calc-sheet__option-check" />
        </button>
      ))}
    </div>
  </dialog>

  <dialog class="calc-sheet" data-sheet="privileges" aria-labelledby="sheet-privileges-title">
    <div class="calc-sheet__handle" aria-hidden="true"></div>
    <div class="calc-sheet__head">
      <p id="sheet-privileges-title" class="h4 calc-sheet__title">Льготы</p>
    </div>
    <div class="calc-sheet__list" role="radiogroup" aria-label="Льготы">
      {calculator.privileges.map((privilege) => (
        <button type="button" role="radio" aria-checked="false" data-sheet-privilege-option={privilege.id} class="calc-sheet__option calc-sheet__option--coffin">
          <span class="calc-sheet__option-text">
            <span class="label-m">{privilege.title}</span>
          </span>
          <span class="body-s-strong calc-sheet__option-price">{privilege.discount === 0 ? '—' : `−${privilege.discount.toLocaleString('ru-RU')} ₽`}</span>
          <Icon name="check" size={18} class="calc-sheet__option-check" />
        </button>
      ))}
    </div>
  </dialog>

  <dialog class="calc-sheet" data-sheet="extras" aria-labelledby="sheet-extras-title">
    <div class="calc-sheet__handle" aria-hidden="true"></div>
    <div class="calc-sheet__head">
      <p id="sheet-extras-title" class="h4 calc-sheet__title">Дополнительные услуги</p>
    </div>
    <div class="calc-sheet__list">
      {calculator.extras.map((extra) => (
        <label class="calc-sheet__checkbox">
          <input type="checkbox" class="calc-sheet__checkbox-input" data-sheet-extra-option={extra.id} />
          <span class="calc-sheet__checkbox-box" aria-hidden="true">
            <Icon name="check" size={12} class="calc-sheet__checkbox-check" />
          </span>
          <span class="body-m calc-sheet__checkbox-label">{extra.title}</span>
          <span class="body-s calc-sheet__checkbox-price">{extra.price === 0 ? '0 ₽' : `+${extra.price.toLocaleString('ru-RU')} ₽`}</span>
        </label>
      ))}
    </div>
    <button type="button" class="label-m calc-sheet__done" data-close-sheet>
      Готово <span data-sheet-extras-sum></span>
    </button>
  </dialog>
</section>

<style>
  .calculator__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }

  @media (min-width: 1024px) {
    .calculator__inner {
      gap: var(--space-48);
    }
  }

  .calculator__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  @media (min-width: 1024px) {
    .calculator__header {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-48);
    }
  }

  .calculator__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .calculator__lead {
    color: var(--color-text-secondary);
  }

  @media (min-width: 1024px) {
    .calculator__lead {
      max-width: 360px;
      flex-shrink: 0;
    }
  }

  /* ===== Тело: форма + смета ===== */

  .calculator__body {
    display: flex;
    flex-direction: column;
    width: 100%;
    border-radius: var(--radius-lg);
    overflow: clip;
  }

  @media (min-width: 1024px) {
    .calculator__body {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-24);
      border-radius: 0;
      overflow: visible;
    }
  }

  .calculator__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    width: 100%;
    padding: var(--space-24);
    background: var(--color-bg-surface);
  }

  @media (min-width: 1024px) {
    .calculator__form {
      flex: 1 0 0;
      min-width: 0;
      gap: var(--space-40);
      padding: var(--space-40);
      border-radius: var(--radius-lg);
    }
  }

  .calculator__group {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    width: 100%;
  }

  .calculator__group-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12);
  }

  .calculator__group-title {
    color: var(--color-text-primary);
  }

  /* [hidden] сам по себе проигрывает по специфичности display:flex выше —
     нужен явный оверрайд (группа «Гроб» скрывается для не-«Похороны»,
     см. <script> внизу) */
  .calculator__group[hidden] {
    display: none;
  }

  .calculator__group-count {
    color: var(--color-text-secondary);
  }

  /* Подчёркивание при наведении — как у ссылок в хедере: полоска растёт
     из центра. */
  .calculator__group-link {
    position: relative;
    color: var(--color-text-secondary);
    transition: color 0.15s ease;
  }

  .calculator__group-link::before {
    content: '';
    width: 0;
    height: 1.5px;
    border-radius: 2px;
    background-color: var(--color-accent-primary);
    position: absolute;
    bottom: -2px;
    left: 50%;
    transition: width 0.3s ease, left 0.3s ease;
  }

  .calculator__group-link:hover {
    color: var(--color-accent-primary);
  }

  .calculator__group-link:hover::before {
    width: 100%;
    left: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .calculator__group-link::before {
      transition: none;
    }
  }

  /* ===== "Что нужно" — desktop grid ===== */

  .calculator__base-grid {
    display: none;
  }

  @media (min-width: 1024px) {
    .calculator__base-grid {
      display: flex;
      flex-wrap: wrap;
      gap: var(--space-8);
      width: 100%;
    }
  }

  .calculator__base-item {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    flex: 1 0 0;
    min-width: 0;
    padding: var(--space-12) var(--space-16);
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-sm);
    text-align: left;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .calculator__base-item--active {
    background: var(--color-accent-soft);
    border-color: var(--color-accent-primary);
  }

  .calculator__base-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 36px;
    height: 36px;
    border-radius: var(--radius-pill);
    background: var(--color-accent-soft);
    color: var(--color-text-primary);
  }

  .calculator__base-item--active .calculator__base-icon {
    background: var(--color-accent-primary);
    color: var(--color-text-inverse);
  }

  .calculator__base-text {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .calculator__base-title {
    color: var(--color-text-primary);
  }

  .calculator__base-price {
    color: var(--color-accent-primary);
  }

  .calculator__base-item:not(.calculator__base-item--active) .calculator__base-price {
    color: var(--color-text-secondary);
  }

  /* ===== Поле-селект (mobile) ===== */

  .calculator__field {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    width: 100%;
    padding: 10px var(--space-16) 10px 10px;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    text-align: left;
  }

  @media (min-width: 1024px) {
    .calculator__field {
      display: none;
    }
  }

  .calculator__field-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 36px;
