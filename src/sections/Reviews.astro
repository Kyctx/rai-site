---
// 07 · Reviews — Отзывы. Desktop 198:2975, mobile 214:4037.
// В макете desktop цитаты были с разных площадок (Яндекс/2ГИС) и другим
// рейтингом (4,2), чем mobile и site.json (4,9, только Яндекс Карты) —
// по решению заказчика приводим обе версии к одной площадке (см. rai-handoff.md, раздел 7).
// Desktop: рейтинг и все три цитаты видны сразу, друг под другом.
// Mobile: одна карточка — рейтинг + один отзыв, листается свайпом,
// точки-индикатор под цитатой.
import Icon from '@components/Icon.astro';
import reviews from '@data/reviews.json';
import site from '@data/site.json';

const stars = Array.from({ length: 5 });
const ratingDisplay = site.reviews.rating.toFixed(1).replace('.', ',');
---

<section id="reviews" aria-labelledby="reviews-title" class="section reviews">
  <div class="container reviews__inner">
    <!-- Desktop: левая колонка — сводная оценка -->
    <div class="reviews__summary">
      <p class="eyebrow">Отзывы семей</p>
      <div class="reviews__score">
        <p class="num-xl reviews__score-value">{ratingDisplay}</p>
        <p class="body-l reviews__score-note">из 5 — по {site.reviews.count} отзывам на {site.reviews.sourcePrepositional}</p>
      </div>
      <div class="reviews__platform">
        <p class="label-m reviews__platform-name">{site.reviews.source}</p>
        <div class="reviews__platform-rating">
          <span class="reviews__stars" aria-hidden="true">
            {stars.map(() => <Icon name="star" size={14} class="reviews__star" />)}
          </span>
          <p class="label-m reviews__platform-value">{ratingDisplay}</p>
        </div>
        <p class="body-s reviews__platform-count">{site.reviews.count} отзывов</p>
      </div>
      <p class="body-s reviews__disclaimer">
        Данные площадок на {reviews.asOfDate}. Мы не удаляем и не редактируем отзывы.
      </p>
    </div>

    <!-- Mobile: заголовок блока. На desktop макет не показывает отдельный
         H2 — там роль заголовка играет eyebrow слева, — но H2 остаётся в
         разметке для семантики (правило "у каждой секции свой H2"),
         визуально скрыт через .reviews__header-mobile на desktop. -->
    <div class="reviews__header-mobile">
      <p class="eyebrow">Отзывы семей</p>
      <h2 id="reviews-title" class="h2 reviews__title-mobile">Что говорят о нас</h2>
    </div>

    <!-- Desktop: список цитат друг под другом -->
    <div class="reviews__quotes">
      {reviews.list.map((review) => (
        <div class="reviews__quote">
          <span class="reviews__stars" aria-hidden="true">
            {stars.map(() => <Icon name="star" size={14} class="reviews__star" />)}
          </span>
          <p class="quote reviews__quote-text">«{review.text}»</p>
          <div class="reviews__quote-author">
            <p class="label-m reviews__quote-name">{review.author}</p>
            <p class="body-s reviews__quote-date">{site.reviews.source}, {review.date}</p>
          </div>
        </div>
      ))}
      <a href={site.reviews.url} class="label-m reviews__all-link" data-metrika-goal="reviews_open">
        Читать все отзывы на {site.reviews.sourcePrepositional}
      </a>
    </div>

    <!-- Mobile: одна карточка, отзывы листаются свайпом -->
    <div class="reviews__card">
      <div class="reviews__card-rating">
        <p class="num-xl reviews__card-rating-value">{ratingDisplay}</p>
        <div class="reviews__card-rating-info">
          <span class="reviews__stars" aria-hidden="true">
            {stars.map(() => <Icon name="star" size={16} class="reviews__star" />)}
          </span>
          <p class="body-s reviews__card-rating-note">{site.reviews.count} отзывов на {site.reviews.sourcePrepositional}</p>
        </div>
      </div>

      <div class="reviews__card-divider" aria-hidden="true"></div>

      <div class="reviews__slider" tabindex="0" role="group" aria-roledescription="слайдер" aria-label="Отзывы семей">
        <div class="reviews__slider-track">
          {reviews.list.map((review) => (
            <div class="reviews__slide">
              <p class="quote reviews__slide-text">«{review.text}»</p>
              <div class="reviews__quote-author">
                <p class="label-s reviews__quote-name">{review.author}</p>
                <p class="body-s reviews__quote-date">{review.date}</p>
              </div>
            </div>
          ))}
        </div>
      </div>

      <div class="reviews__dots" role="tablist" aria-label="Выбор отзыва">
        {reviews.list.map((_, i) => (
          <button
            type="button"
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-label={`Отзыв ${i + 1} из ${reviews.list.length}`}
            class:list={['reviews__dot', { 'reviews__dot--active': i === 0 }]}
          ></button>
        ))}
      </div>
    </div>

    <a href={site.reviews.url} class="label-m reviews__all-button" data-metrika-goal="reviews_open">
      <Icon name="pin" size={18} />
      Читать все {site.reviews.count} отзывов
    </a>
  </div>
</section>

<style>
  .reviews__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
  }

  @media (min-width: 1024px) {
    .reviews__inner {
      flex-direction: row;
      align-items: flex-start;
      justify-content: space-between;
      gap: var(--space-48);
    }
  }

  /* ===== Desktop: сводная оценка (левая колонка) ===== */

  .reviews__summary {
    display: none;
  }

  @media (min-width: 1024px) {
    .reviews__summary {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: var(--space-16);
      width: 440px;
      flex-shrink: 0;
    }
  }

  .reviews__score {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    color: var(--color-text-primary);
  }

  .reviews__score-value {
    line-height: 1;
  }

  .reviews__score-note {
    color: var(--color-text-primary);
    max-width: 360px;
  }

  .reviews__platform {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-12);
    width: 100%;
    padding-top: var(--space-20);
    padding-bottom: var(--space-20);
    border-top: 1px solid var(--color-text-primary);
  }

  .reviews__platform-name {
    color: var(--color-text-primary);
  }

  .reviews__platform-rating {
    display: flex;
    align-items: center;
    gap: var(--space-12);
    margin-top: var(--space-8);
  }

  .reviews__platform-value {
    color: var(--color-text-primary);
  }

  .reviews__platform-count {
    color: var(--color-text-secondary);
  }

  .reviews__disclaimer {
    color: var(--color-text-secondary);
  }

  /* ===== Mobile: заголовок блока ===== */

  .reviews__header-mobile {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  @media (min-width: 1024px) {
    .reviews__header-mobile {
      display: none;
    }
  }

  .reviews__title-mobile {
    color: var(--color-text-primary);
  }

  /* ===== Звёзды (общее для desktop и mobile) ===== */

  .reviews__stars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
  }

  /* :global — Icon.astro вставляет SVG через set:html, у него нет
     scoped-атрибута Astro, обычный селектор компонента его не достанет
     (см. похожий комментарий в Trust.astro) */
  .reviews__stars :global(.reviews__star) {
    color: var(--color-accent-primary);
    fill: var(--color-accent-primary);
  }

  /* ===== Desktop: список цитат ===== */

  .reviews__quotes {
    display: none;
  }

  @media (min-width: 1024px) {
    .reviews__quotes {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      width: 620px;
      flex-shrink: 0;
    }
  }

  .reviews__quote {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-16);
    padding-block: var(--space-32);
    border-bottom: 1px solid var(--color-border-default);
    width: 100%;
  }

  .reviews__quotes > .reviews__quote:first-child {
    padding-top: 0;
  }

  .reviews__quote-text {
    color: var(--color-text-primary);
  }

  .reviews__quote-author {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  .reviews__quote-name {
    color: var(--color-text-primary);
  }

  .reviews__quote-date {
    color: var(--color-text-secondary);
  }

  .reviews__all-link {
    padding-top: var(--space-8);
    color: var(--color-accent-primary);
  }

  .reviews__all-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1.5px;
  }

  /* ===== Mobile: карточка со слайдером ===== */

  .reviews__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    width: 100%;
    padding: var(--space-24) var(--space-20);
    background: var(--color-bg-surface);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 1024px) {
    .reviews__card {
      display: none;
    }
  }

  .reviews__card-rating {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    width: 100%;
  }

  .reviews__card-rating-value {
    color: var(--color-text-primary);
    line-height: 1;
  }

  .reviews__card-rating-info {
    display: flex;
    flex-direction: column;
    gap: 6px;
    flex: 1 0 0;
    min-width: 0;
  }

  .reviews__card-rating-note {
    color: var(--color-text-secondary);
  }

  .reviews__card-divider {
    width: 100%;
    height: 1px;
    background: var(--color-border-default);
  }

  .reviews__slider {
    width: 100%;
    overflow: hidden;
  }

  .reviews__slider-track {
    display: flex;
    width: 100%;
    scroll-snap-type: x mandatory;
    overflow-x: auto;
    scrollbar-width: none;
    gap: var(--space-20);
  }

  .reviews__slider-track::-webkit-scrollbar {
    display: none;
  }

  .reviews__slide {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    flex: 0 0 100%;
    scroll-snap-align: start;
    min-width: 0;
  }

  .reviews__slide .reviews__quote-name {
    color: var(--color-text-primary);
  }

  .reviews__dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }

  .reviews__dot {
    width: 6px;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--color-border-default);
    transition: width 0.2s ease, background-color 0.2s ease;
  }

  .reviews__dot--active {
    width: 20px;
    background: var(--color-accent-primary);
  }

  /* ===== Mobile: кнопка "Читать все N отзывов" ===== */

  .reviews__all-button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    padding: var(--space-16) var(--space-24);
    border: 1px solid var(--color-text-primary);
    border-radius: var(--radius-pill);
    color: var(--color-text-primary);
  }

  @media (min-width: 1024px) {
    .reviews__all-button {
      display: none;
    }
  }

  .reviews__all-button:hover {
    border-color: var(--color-accent-primary);
    color: var(--color-accent-primary);
  }

  @media (prefers-reduced-motion: reduce) {
    .reviews__dot {
      transition: none;
    }
  }
</style>

<script>
  const root = document.querySelector('.reviews');
  if (root) {
    const track = root.querySelector<HTMLElement>('.reviews__slider-track');
    const slides = Array.from(root.querySelectorAll<HTMLElement>('.reviews__slide'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('.reviews__dot'));

    if (track && slides.length && dots.length) {
      const setActive = (index: number) => {
        dots.forEach((dot, i) => {
          dot.classList.toggle('reviews__dot--active', i === index);
          dot.setAttribute('aria-selected', String(i === index));
        });
      };

      // Клик по точке — прокрутить слайдер к нужному отзыву
      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          slides[index]?.scrollIntoView({ behavior: 'smooth', inline: 'start', block: 'nearest' });
        });
      });

      // Свайп/скролл — подсветить точку ближайшего видимого отзыва
      let ticking = false;
      track.addEventListener('scroll', () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          const trackRect = track.getBoundingClientRect();
          let closest = 0;
          let closestDist = Infinity;
          slides.forEach((slide, i) => {
            const dist = Math.abs(slide.getBoundingClientRect().left - trackRect.left);
            if (dist < closestDist) {
              closestDist = dist;
              closest = i;
            }
          });
          setActive(closest);
          ticking = false;
        });
      });
    }
  }
</script>
