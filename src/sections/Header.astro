---
// 00 · Хедер. Desktop 198:2587 — пилюля с логотипом, ссылками и кнопкой-телефоном.
// Mobile 214:3649 — компактная пилюля (лого + кнопки «Позвонить»/«Меню»),
// по тапу на «Меню» открывается полноэкранное мобильное меню (214:4722).
import Logo from '@components/Logo.astro';
import Icon from '@components/Icon.astro';
import site from '@data/site.json';

// Пункты меню → секции главной (id из таблицы в CLAUDE.md).
const navLinks = [
  { label: 'Услуги', href: '#services' },
  { label: 'Каталог', href: '#pricing' },
  { label: 'Калькулятор', href: '#calculator' },
  { label: 'Справочник', href: '#guide' },
  { label: 'Контакты', href: '#contact' },
];

const telHref = `tel:${site.phone.tel}`;
---

<header class="header">
  <div class="header__bar">
    <!-- Desktop: логотип + ссылки + телефон в одной пилюле -->
    <nav class="header__pill header__pill--desktop" aria-label="Основная навигация">
      <div class="header__group">
        <a href="#top" class="header__logo" aria-label={`${site.brand} — на главную`}>
          <Logo width={61} />
        </a>
        <span class="header__divider" aria-hidden="true"></span>
        <ul class="header__links">
          {navLinks.map((item) => (
            <li><a href={item.href} class="label-m header__link">{item.label}</a></li>
          ))}
        </ul>
      </div>
      <a href={telHref} class="header__phone-btn pill-hover label-m" data-goal="call_click">
        <Icon name="phone" size={18} />
        {site.phone.display}
      </a>
    </nav>

    <!-- Mobile: компактная пилюля -->
    <div class="header__pill header__pill--mobile">
      <a href="#top" class="header__logo" aria-label={`${site.brand} — на главную`}>
        <Logo width={53} />
      </a>
      <div class="header__actions">
        <a href={telHref} class="header__icon-btn header__icon-btn--accent pill-hover" aria-label="Позвонить" data-goal="call_click">
          <Icon name="phone" size={20} />
        </a>
        <button
          type="button"
          class="header__icon-btn pill-hover"
          id="menu-toggle"
          aria-label="Открыть меню"
          aria-expanded="false"
          aria-controls="mobile-menu"
        >
          <svg class="menu-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" focusable="false">
            <line class="menu-icon__line menu-icon__line--top" x1="2.5" y1="6" x2="17.5" y2="6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <line class="menu-icon__line menu-icon__line--mid" x1="2.5" y1="10" x2="17.5" y2="10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
            <line class="menu-icon__line menu-icon__line--bottom" x1="2.5" y1="14" x2="17.5" y2="14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Мобильное меню на весь экран (214:4722). Пилюля с логотипом и кнопками
       (звонок + переключатель) не дублируется здесь — остаётся видна поверх
       оверлея та же самая из .header__pill--mobile (z-index хедера выше). -->
  <div class="mobile-menu" id="mobile-menu" aria-hidden="true">
    <div class="mobile-menu__spacer" aria-hidden="true"></div>

    <div class="mobile-menu__content">
      <ul class="mobile-menu__links">
        {navLinks.map((item) => (
          <li>
            <a href={item.href} class="mobile-menu__link h4">
              {item.label}
              <Icon name="arrow" size={20} />
            </a>
          </li>
        ))}
      </ul>

      <div class="mobile-menu__contact">
        <p class="eyebrow mobile-menu__eyebrow">Круглосуточная линия</p>
        <a href={telHref} class="num-l mobile-menu__phone" data-goal="call_click">{site.phone.display}</a>
        <div class="mobile-menu__buttons">
          <a href={telHref} class="button button--accent pill-hover button--m" data-goal="call_click">
            <Icon name="phone" size={18} />
            <span class="label-m">Позвонить</span>
          </a>
          <a href={`https://t.me/${site.messengers.telegram}`} class="button button--outline pill-hover button--m">
            <Icon name="message" size={18} />
            <span class="label-m">Написать в Telegram или MAX</span>
          </a>
        </div>
        <p class="body-s mobile-menu__address">{site.address.text} · {site.address.hours}</p>
      </div>
    </div>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: var(--space-12);
    z-index: 100;
    padding-inline: var(--space-12);
  }

  @media (min-width: 1024px) {
    .header {
      top: var(--space-20);
      padding-inline: var(--space-page-x);
      display: flex;
      justify-content: center;
    }
  }

  .header__bar {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    position: relative;
    z-index: 201;
  }

  @media (min-width: 1024px) {
    .header__bar {
      width: auto;
    }
  }

  .header__pill {
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: var(--color-bg-surface);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-sm);
    padding: var(--space-8);
    padding-left: var(--space-20);
  }

  .header__pill--desktop {
    display: none;
  }

  @media (min-width: 1024px) {
    .header__pill--desktop {
      display: flex;
      justify-content: normal;
      gap: var(--space-40);
      height: 71px;
      padding-left: 22px;
      width: fit-content;
    }
    .header__pill--mobile {
      display: none;
    }
  }

  .header__group {
    display: flex;
    align-items: center;
    gap: var(--space-20);
  }

  .header__logo {
    display: flex;
    align-items: center;
  }

  .header__divider {
    width: 1px;
    height: 22px;
    background: var(--color-border-default);
  }

  .header__links {
    display: flex;
    align-items: center;
    gap: 28px;
  }

  .header__link {
    color: var(--color-text-primary);
    white-space: nowrap;
    position: relative;
    transition: color 0.15s ease;
  }

  .header__link::before {
    content: '';
    width: 0;
    height: 1.5px;
    border-radius: 2px;
    background-color: var(--color-accent-primary);
    position: absolute;
    bottom: -4px;
    left: 50%;
    transition: width 0.3s ease, left 0.3s ease;
  }

  .header__link:hover {
    color: var(--color-accent-primary);
  }

  .header__link:hover::before {
    width: 100%;
    left: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .header__link::before {
      transition: none;
    }
  }

  .header__phone-btn {
    display: flex;
    align-items: center;
    gap: 10px;
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
    border-radius: var(--radius-pill);
    padding: 18px 30px;
    white-space: nowrap;
  }

  /* Анимация pill-кнопок: заливка кругом из центра + свечение
     (по референсу пользователя, Uiverse.io by gharsh11032000; без scale самой кнопки).
     Сторона квадрата = ширине кнопки (padding-bottom: 100% от width) —
     работает на любом соотношении сторон без подбора числа под конкретную
     кнопку. scale(0) стягивает круг в точку по центру. На hover — не
     scale(1): круг диаметром в ширину кнопки не достаёт до дальних УГЛОВ
     прямоугольника (они дальше центра на величину, зависящую от высоты) —
     1.5 даёт запас с любой разумной высотой кнопки. */
  .pill-hover {
    position: relative;
    overflow: hidden;
    z-index: 0;
    transition: box-shadow 0.3s cubic-bezier(0.23, 1, 0.32, 1), color 0.3s ease;
  }

  .pill-hover::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 100%;
    height: 0;
    padding-bottom: 100%;
    border-radius: 50%;
    scale: 0;
    z-index: -1;
    transition: scale 0.5s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .pill-hover:hover::before {
    scale: 1.7;
    transition-duration: 0.9s;
  }

  @media (prefers-reduced-motion: reduce) {
    .pill-hover,
    .pill-hover::before {
      transition: none;
    }
  }

  .header__phone-btn::before {
    background-color: var(--color-accent-primary);
  }

  .header__phone-btn:hover {
    color: var(--color-text-inverse);
    box-shadow: 0 0 20px rgba(86, 99, 75, 0.4);
  }

  /* Мобильная пилюля */
  .header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  .header__icon-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-pill);
    background: var(--color-bg-page);
    color: var(--color-text-primary);
    flex-shrink: 0;
  }

  .header__icon-btn::before {
    background-color: var(--color-accent-soft);
  }

  .header__icon-btn:hover {
    box-shadow: 0 0 16px rgba(86, 99, 75, 0.25);
  }

  .header__icon-btn--accent {
    background: var(--color-accent-primary);
    color: var(--color-text-inverse);
  }

  .header__icon-btn--accent::before {
    background-color: var(--color-accent-hover);
  }

  .header__icon-btn--accent:hover {
    color: var(--color-text-inverse);
    box-shadow: 0 0 20px rgba(86, 99, 75, 0.4);
  }

  /* Полноэкранное мобильное меню — вместо сплошного бежевого фона (совпадал
     с фоном страницы и выглядел «немым») задний план прозрачный: тонкая
     тёмная вуаль + блюр показывают страницу под меню, читаемость даёт сама
     белая карточка .mobile-menu__content. Открытие/закрытие — через класс
     is-open (а не [hidden]), чтобы можно было анимировать: opacity+blur
     у вуали, opacity+сдвиг у карточки, вложенная задержка у пунктов меню. */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(38, 41, 44, 0.4);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    padding: var(--space-12) var(--space-12) var(--space-32);
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
    overflow-y: auto;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s ease, visibility 0s linear 0.3s;
  }

  .mobile-menu.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transition: opacity 0.3s ease, visibility 0s linear 0s;
  }

  @media (min-width: 1024px) {
    .mobile-menu {
      display: none !important;
    }
  }

  /* Место под реальную пилюлю хедера — она не дублируется в разметке,
     а остаётся на месте (z-index хедера выше .mobile-menu). */
  .mobile-menu__spacer {
    height: 60px;
    flex-shrink: 0;
  }

  /* Иконка меню: три линии бургера, анимированно складывающиеся в крестик.
     Верхняя и нижняя поворачиваются на 45°/-45° и сходятся в центр
     (на позицию средней линии, y=10), средняя тем временем исчезает.
     transform-box: view-box (а не fill-box) — важно: иначе точка поворота
     у каждой линии своя (центр её собственного бокса, т.е. y=6 и y=14
     вместо общего y=10), и после translate+rotate крест получается
     смещённым от центра кнопки — сам крестик выглядит «кривым». */
  .menu-icon__line {
    transform-box: view-box;
    transform-origin: center;
    transition: transform 0.35s cubic-bezier(0.65, 0, 0.35, 1), opacity 0.25s ease;
  }

  /* CSS transform применяется справа налево: сначала translateY (сдвиг
     линии к центру, в её исходной системе координат), потом rotate
     (поворот уже сдвинутой линии вокруг её собственного center).
     Обратный порядок (rotate затем translateY) давал перекошенный крест —
     сдвиг применялся бы в повёрнутых, а не в исходных вертикальных осях. */
  .menu-icon.is-open .menu-icon__line--top {
    transform: rotate(45deg) translateY(4px);
  }

  .menu-icon.is-open .menu-icon__line--mid {
    opacity: 0;
  }

  .menu-icon.is-open .menu-icon__line--bottom {
    transform: rotate(-45deg) translateY(-4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .menu-icon__line {
      transition: none;
    }
    /* Глобальное правило в base.css обнуляет transition-duration, но не
       transition-delay — без этого каскад пунктов меню всё равно ждал бы
       свою задержку перед мгновенным появлением */
    .mobile-menu__content,
    .mobile-menu__link {
      transition-delay: 0s;
    }
  }

  .mobile-menu__content {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
    padding: var(--space-24) var(--space-16);
    background: var(--color-bg-surface);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    flex: 1;
    opacity: 0;
    transform: translateY(-16px) scale(0.98);
    transition: opacity 0.35s cubic-bezier(0.23, 1, 0.32, 1), transform 0.35s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .mobile-menu.is-open .mobile-menu__content {
    opacity: 1;
    transform: none;
    transition-delay: 0.05s;
  }

  .mobile-menu__links {
    display: flex;
    flex-direction: column;
  }

  .mobile-menu__link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-16);
    border-bottom: 1px solid var(--color-border-default);
    color: var(--color-text-primary);
    opacity: 0;
    transform: translateY(10px);
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .mobile-menu.is-open .mobile-menu__link {
    opacity: 1;
    transform: none;
  }

  /* Каскад: каждый следующий пункт появляется чуть позже предыдущего */
  .mobile-menu__links li:nth-child(1) .mobile-menu__link { transition-delay: 0.12s; }
  .mobile-menu__links li:nth-child(2) .mobile-menu__link { transition-delay: 0.16s; }
  .mobile-menu__links li:nth-child(3) .mobile-menu__link { transition-delay: 0.2s; }
  .mobile-menu__links li:nth-child(4) .mobile-menu__link { transition-delay: 0.24s; }
  .mobile-menu__links li:nth-child(5) .mobile-menu__link { transition-delay: 0.28s; }

  .mobile-menu__contact {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    margin-top: auto;
  }

  .mobile-menu__eyebrow {
    color: var(--color-accent-primary);
  }

  .mobile-menu__phone {
    color: var(--color-text-primary);
  }

  .mobile-menu__buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    padding-top: var(--space-8);
  }

  .mobile-menu__address {
    color: var(--color-text-secondary);
  }

  /* Кнопки (используются здесь локально; общий компонент Button.astro — при вёрстке Hero) */
  .button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border-radius: var(--radius-pill);
    padding-block: var(--space-16);
    width: 100%;
    text-align: center;
  }

  .button--dark {
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
  }

  .button--dark::before {
    background-color: var(--color-accent-primary);
  }

  .button--dark:hover {
    color: var(--color-text-inverse);
    box-shadow: 0 0 20px rgba(86, 99, 75, 0.4);
  }

  .button--accent {
    background: var(--color-accent-primary);
    color: var(--color-text-inverse);
  }

  .button--accent::before {
    background-color: var(--color-accent-hover);
  }

  .button--accent:hover {
    color: var(--color-text-inverse);
    box-shadow: 0 0 20px rgba(86, 99, 75, 0.4);
  }

  .button--outline {
    background: transparent;
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-default);
  }

  .button--outline::before {
    background-color: var(--color-accent-primary);
  }

  .button--outline:hover {
    color: var(--color-text-inverse);
    border-color: var(--color-accent-primary);
    box-shadow: 0 0 20px rgba(86, 99, 75, 0.4);
  }
</style>

<script>
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (toggle && menu) {
    const toggleIcon = toggle.querySelector('.menu-icon');

    const open = () => {
      menu.classList.add('is-open');
      menu.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      toggle.setAttribute('aria-expanded', 'true');
      toggle.setAttribute('aria-label', 'Закрыть меню');
      toggleIcon?.classList.add('is-open');
    };

    const close = () => {
      menu.classList.remove('is-open');
      menu.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Открыть меню');
      toggleIcon?.classList.remove('is-open');
    };

    toggle.addEventListener('click', () => {
      if (!menu.classList.contains('is-open')) open();
      else close();
    });

    menu.addEventListener('click', (event) => {
      if (event.target instanceof HTMLElement && event.target.closest('a')) {
        close();
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.classList.contains('is-open')) {
        close();
        toggle.focus();
      }
    });
  }
</script>
