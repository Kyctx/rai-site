---
// 10 · Faq — Вопросы. Desktop 198:3216, mobile 214:4278.
// Слева — заголовок, лид и телефон (desktop — строкой, mobile — карточка
// «Бесплатная консультация 24/7» с кнопкой звонка). Справа/снизу — список
// вопросов: кнопка + aria-expanded (правило 6 в CLAUDE.md), открыт первый
// пункт; клик раскрывает один вопрос и закрывает остальные (аккордеон,
// а не независимые переключатели), анимация — через <script> ниже.
import Icon from '@components/Icon.astro';
import site from '@data/site.json';

const telHref = `tel:${site.phone.tel}`;

// В макете (198:3216 / 214:4278) текст ответа есть только у первого
// вопроса — у остальных шести слоя с ответом нет вообще (не проработано в
// Figma). Ответы ниже — демонстрационные (используют факты, уже принятые
// в других секциях: время приезда агента — Process/Hero, табельный номер —
// Trust, перевозка из другого города — Calculator/prices.json), заменить
// на согласованные с заказчиком перед запуском (см. CLAUDE.md → «Заглушки»).
const items = [
  {
    question: 'Сколько стоят похороны и из чего складывается цена?',
    answer: 'Стоимость зависит от выбора кладбища или крематория, гроба и дополнительных услуг. Мы составляем подробную смету и фиксируем её в договоре — итоговая сумма не меняется.',
  },
  {
    question: 'Какие документы нужны?',
    answer: 'Для начала — паспорт того, кто организует похороны, и медицинское свидетельство о смерти. Остальные документы агент оформит вместе с вами или получит сам по доверенности.',
  },
  {
    question: 'Можно ли оплатить после похорон или в рассрочку?',
    answer: 'Да. Платить можно после того, как всё сделано, — в том числе из пособия на погребение. Если суммы не хватает, остаток можно оформить в рассрочку без переплаты.',
  },
  {
    question: 'Как получить пособие на погребение?',
    answer: 'Агент поможет собрать документы и подать заявление в Соцфонд в день обращения — решение приходит за 1 рабочий день, деньги — в течение 3.',
  },
  {
    question: 'Как быстро приедет агент?',
    answer: 'Агент выезжает сразу после звонка и обычно приезжает в течение 40–60 минут — по Нижнему Новгороду и области.',
  },
  {
    question: 'Как проверить, что агент из вашей службы?',
    answer: 'У каждого агента — табельный номер и удостоверение с фото. Позвоните на общий номер и продиктуйте его — оператор подтвердит, что агент наш.',
  },
  {
    question: 'Работаете ли вы с другими городами?',
    answer: 'Да, организуем перевозку из другого города и региона — стоимость считаем по километражу, документы оформляем на месте.',
  },
];
---

<section id="faq" aria-labelledby="faq-title" class="section faq">
  <div class="container faq__inner">
    <div class="faq__intro">
      <p class="eyebrow faq__eyebrow">Вопросы и ответы</p>
      <h2 id="faq-title" class="h2">
        Отвечаем на то,<br /> <em>о чём спрашивают чаще всего</em>
      </h2>
      <p class="body-l faq__lead">
        Не нашли ответ? Позвоните — консультация бесплатна и ни к чему не обязывает.
      </p>

      <!-- Desktop: строка иконка + номер -->
      <a href={telHref} class="faq__phone faq__phone--desktop" data-goal="call_click">
        <Icon name="phone" size={18} />
        <span class="label-m">{site.phone.display}</span>
      </a>

      <!-- Mobile: карточка с кнопкой звонка -->
      <div class="faq__phone-card">
        <div class="faq__phone-card-text">
          <p class="body-s faq__phone-card-label">Бесплатная консультация 24/7</p>
          <p class="h4 faq__phone-card-number">{site.phone.display}</p>
        </div>
        <a href={telHref} class="faq__phone-card-btn" aria-label="Позвонить" data-goal="call_click">
          <Icon name="phone" size={22} />
        </a>
      </div>
    </div>

    <ul class="faq__list" data-faq-list>
      {items.map((item, index) => (
        <li>
          <div class:list={['faq__item', { 'faq__item--open': index === 0 }]} data-faq-item>
            <button
              type="button"
              class="faq__item-summary"
              id={`faq-toggle-${index}`}
              aria-expanded={index === 0 ? 'true' : 'false'}
              aria-controls={`faq-panel-${index}`}
            >
              <span class="title faq__item-question">{item.question}</span>
              <span class="faq__item-toggle" aria-hidden="true">
                <Icon name="plus" size={20} class="faq__item-icon faq__item-icon--plus" />
                <Icon name="chevron" size={20} class="faq__item-icon faq__item-icon--chevron" />
              </span>
            </button>
            <div id={`faq-panel-${index}`} role="region" aria-labelledby={`faq-toggle-${index}`} class="faq__item-panel">
              <div class="faq__item-panel-inner">
                <p class="body-m faq__item-answer">{item.answer}</p>
              </div>
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .faq__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-40);
  }

  @media (min-width: 1024px) {
    .faq__inner {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-96);
    }
  }

  /* ===== Слева: заголовок, лид, телефон ===== */

  .faq__intro {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    width: 100%;
  }

  @media (min-width: 1024px) {
    .faq__intro {
      width: 400px;
      flex-shrink: 0;
    }
  }

  .faq__eyebrow {
    color: var(--color-accent-primary);
  }

  .faq__lead {
    color: var(--color-text-secondary);
  }

  .faq__phone {
    display: none;
  }

  @media (min-width: 1024px) {
    .faq__phone--desktop {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      color: var(--color-text-primary);
      white-space: nowrap;
      transition: color 0.2s ease;
    }

    .faq__phone--desktop:hover {
      color: var(--color-accent-primary);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__phone--desktop {
      transition: none;
    }
  }

  .faq__phone-card {
    display: flex;
    align-items: center;
    gap: var(--space-16);
    width: 100%;
    padding: var(--space-20);
    background: var(--color-bg-surface);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 1024px) {
    .faq__phone-card {
      display: none;
    }
  }

  .faq__phone-card-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    flex: 1 0 0;
    min-width: 0;
  }

  .faq__phone-card-label {
    color: var(--color-text-secondary);
  }

  .faq__phone-card-number {
    color: var(--color-text-primary);
  }

  .faq__phone-card-btn {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 52px;
    height: 52px;
    background: var(--color-accent-primary);
    color: var(--color-text-inverse);
    border-radius: var(--radius-pill);
    transition: background-color 0.2s ease;
  }

  .faq__phone-card-btn:hover {
    background: var(--color-accent-hover);
  }

  /* ===== Справа: список вопросов ===== */

  .faq__list {
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
  }

  @media (min-width: 1024px) {
    .faq__list {
      flex: 1 1 0;
    }
  }

  .faq__item {
    display: flex;
    flex-direction: column;
    width: 100%;
    padding-block: var(--space-20);
    border-bottom: 1px solid var(--color-border-default);
  }

  @media (min-width: 1024px) {
    .faq__item {
      padding-block: var(--space-32);
    }
  }

  .faq__list > li:first-child .faq__item {
    border-top: 1px solid var(--color-border-default);
  }

  .faq__item-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
    width: 100%;
    text-align: left;
  }

  .faq__item-question {
    flex: 1 0 0;
    min-width: 0;
    color: var(--color-text-primary);
  }

  .faq__item-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    background: var(--color-bg-surface);
    color: var(--color-text-primary);
    border-radius: var(--radius-pill);
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }

  /* Наведение на всю строку вопроса — кружок чуть увеличивается и темнеет */
  .faq__item-summary:hover .faq__item-toggle {
    background: var(--color-border-default);
    transform: scale(1.08);
  }

  .faq__item--open .faq__item-toggle {
    background: var(--color-accent-primary);
    color: var(--color-text-inverse);
  }

  .faq__item--open .faq__item-summary:hover .faq__item-toggle {
    background: var(--color-accent-hover);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__item-toggle {
      transition: background-color 0.2s ease, color 0.2s ease;
    }

    .faq__item-summary:hover .faq__item-toggle {
      transform: none;
    }
  }

  :global(.faq__item-icon) {
    flex-shrink: 0;
  }

  :global(.faq__item-icon--chevron) {
    display: none;
  }

  .faq__item--open :global(.faq__item-icon--plus) {
    display: none;
  }

  .faq__item--open :global(.faq__item-icon--chevron) {
    display: block;
  }

  /* ===== Плавное раскрытие ответа ===== */
  /* Классический grid-rows-трюк: трек 0fr → 1fr анимируется как обычная
     высота, без измерения scrollHeight в JS. overflow:hidden на вложенном
     div нужен, чтобы контент не «протекал» наружу, пока трек ещё узкий. */
  .faq__item-panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.3s ease;
  }

  .faq__item--open .faq__item-panel {
    grid-template-rows: 1fr;
  }

  .faq__item-panel-inner {
    overflow: hidden;
    min-height: 0;
  }

  .faq__item-answer {
    padding-top: var(--space-16);
    color: var(--color-text-secondary);
  }

  @media (min-width: 1024px) {
    .faq__item-answer {
      max-width: 620px;
    }
  }
</style>

<script>
  // Аккордеон-эксклюзив: раскрыт максимум один пункт — клик по закрытому
  // раскрывает его и закрывает остальные; клик по открытому закрывает его.
  const root = document.querySelector('.faq');
  if (root) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('[data-faq-item]'));

    const setOpen = (item: HTMLElement, open: boolean) => {
      const toggle = item.querySelector<HTMLButtonElement>('.faq__item-summary');
      item.classList.toggle('faq__item--open', open);
      toggle?.setAttribute('aria-expanded', String(open));
    };

    items.forEach((item) => {
      item.querySelector('.faq__item-summary')?.addEventListener('click', () => {
        const willOpen = !item.classList.contains('faq__item--open');
        items.forEach((other) => setOpen(other, other === item ? willOpen : false));
      });
    });
  }
</script>
