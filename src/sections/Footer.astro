---
// 13 · Footer — Футер. Desktop 198:3334, mobile 214:4396.
// Тёмная карточка (bg/inverse) с закруглением, вложенная в bg/page с
// небольшим полем вокруг (padding у корневой секции).
// Колонки ссылок: 4 в ряд на desktop, 2×2 на mobile (Контакты — на всю
// ширину). Реквизиты — заглушки (см. site.json.legal._note), заменить
// перед запуском.
// Логотип — public/icons/logo-light.svg (светлая заливка + подпись
// «Ритуальная компания» уже встроены в SVG, отдельный текст не нужен).
import Icon from '@components/Icon.astro';
import site from '@data/site.json';

const telHref = `tel:${site.phone.tel}`;

const columns = [
  {
    title: 'Услуги',
    links: [
      { label: 'Организация похорон', href: '#pricing' },
      { label: 'Кремация', href: '#pricing' },
      { label: 'Место на кладбище', href: '#' },
      { label: 'Перевозка из другого города', href: '#' },
      { label: 'Памятники и уход', href: '#' },
    ],
  },
  {
    title: 'Информация',
    links: [
      { label: 'Цены и пакеты', href: '#pricing' },
      { label: 'Что делать прямо сейчас', href: '#' },
      { label: 'Пособия и льготы', href: '#' },
      { label: 'Справочник', href: '#' },
      { label: 'Вопросы и ответы', href: '#' },
    ],
  },
  {
    title: 'О компании',
    links: [
      { label: 'О нас', href: '#' },
      { label: 'Наши агенты', href: '#agents' },
      { label: 'Проверить агента', href: '#' },
      { label: 'Отзывы', href: '#reviews' },
      { label: 'Документы и лицензии', href: '#' },
    ],
  },
];

// BASE_URL учитывает /rai-site/ на GitHub Pages (см. astro.config.mjs) —
// внутренние страницы должны идти через него, а не как жёсткий "/путь".
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const legalDocs = [
  { label: 'Политика обработки персональных данных', href: `${base}/privacy` },
  { label: 'Согласие на обработку ПДн', href: `${base}/consent` },
  { label: 'Образец договора', href: site.contractSampleUrl },
];
---

<footer class="footer">
  <div class="footer__card">
    <div class="footer__top">
      <div class="footer__phone-block">
        <p class="h4 footer__phone-lead">Мы рядом круглосуточно — справляться в одиночку не придётся.</p>
        <a href={telHref} class="footer__phone" data-goal="call_click">{site.phone.display}</a>
      </div>
      <div class="footer__buttons">
        <a href={telHref} class="footer__btn footer__btn--primary label-m" data-goal="call_click">
          <Icon name="phone" size={18} />
          Заказать звонок
        </a>
        <a href={`https://t.me/${site.messengers.telegram}`} class="footer__btn footer__btn--outline label-m" data-goal="messenger_click">
          <Icon name="message" size={18} />
          Написать в Telegram
        </a>
        <a href={site.messengers.max} class="footer__btn footer__btn--outline label-m" data-goal="messenger_click">
          <Icon name="message" size={18} />
          Написать в MAX
        </a>
      </div>
    </div>

    <div class="footer__divider" aria-hidden="true"></div>

    <nav class="footer__columns" aria-label="Разделы сайта">
      {columns.map((col) => (
        <div class="footer__column">
          <p class="label-s footer__column-title">{col.title}</p>
          <ul class="footer__column-list">
            {col.links.map((link) => (
              <li><a href={link.href} class="body-s footer__column-link">{link.label}</a></li>
            ))}
          </ul>
        </div>
      ))}

      <div class="footer__column footer__column--contacts">
        <p class="label-s footer__column-title">Контакты</p>
        <div class="footer__contact-block">
          <p class="body-s footer__contact-primary">{site.address.text}</p>
          <p class="body-s footer__contact-secondary">{site.address.hours}</p>
        </div>
        <div class="footer__contact-block">
          <a href={`mailto:${site.email.address}`} class="body-s footer__contact-primary footer__contact-link">{site.email.address}</a>
          <p class="body-s footer__contact-secondary">{site.email.note}</p>
        </div>
      </div>
    </nav>

    <div class="footer__legal">
      <div class="footer__brand">
        <img src={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/icons/logo-light.svg`} alt={`${site.brand} — ${site.tagline}`} width="81" height="49" class="footer__logo" loading="lazy" decoding="async" />
      </div>

      <div class="footer__legal-text">
        <ul class="footer__legal-docs">
          {legalDocs.map((doc) => (
            <li><a href={doc.href} class="body-s footer__legal-link">{doc.label}</a></li>
          ))}
        </ul>
        <p class="body-s footer__legal-copy">
          © {new Date().getFullYear()} {site.legal.company} · ИНН {site.legal.inn === 'TODO' ? '7700000000' : site.legal.inn} · ОГРН {site.legal.ogrn === 'TODO' ? '1267700000000' : site.legal.ogrn}
        </p>
      </div>
    </div>
  </div>
</footer>

<style>
  /* padding-top — var(--space-section-y), как у обычных .section: иначе
     отступ до футера получается вдвое меньше, чем между остальными
     секциями (снизу у Contact — тот же токен, а сверху у футера
     раньше было 0). Это же поле — тот самый видимый «отступ» перед
     тёмной карточкой в эффекте ниже. */
  /* position: fixed — футер всегда стоит внизу вьюпорта, под <main>
     (у которого z-index выше и свой фон, см. base.css). Скролл всё
     это время просто двигает <main>: пока внизу main есть контент,
     футер им перекрыт, а когда контент кончается и открывается
     .footer-spacer (его высоту синхронизирует со высотой футера скрипт
     в Base.astro), футер оказывается «раскрыт» — визуально выезжает
     снизу вверх и перекрывает предыдущую секцию, потому что сам никуда
     не двигается, а уходит вверх именно контент над ним. */
  .footer {
    position: fixed;
    inset-inline: 0;
    inset-block-end: 0;
    z-index: 0;
    padding: var(--space-section-y) var(--space-8) var(--space-8);
  }

  @media (min-width: 1024px) {
    .footer {
      padding: var(--space-section-y) var(--space-24) var(--space-24);
    }
  }

  .footer__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
    width: 100%;
    padding: var(--space-40) var(--space-24) var(--space-32);
    background: var(--color-bg-inverse);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 1024px) {
    .footer__card {
      gap: var(--space-48);
      padding: var(--space-96) var(--space-96) var(--space-40);
    }
  }

  /* ===== Верх: телефон + кнопки ===== */

  .footer__top {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
    width: 100%;
  }

  @media (min-width: 1024px) {
    .footer__top {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-24);
    }
  }

  .footer__phone-block {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    width: 100%;
    color: var(--color-text-inverse);
  }

  .footer__phone-lead {
    color: var(--color-text-inverse);
  }

  @media (min-width: 1024px) {
    .footer__phone-lead {
      max-width: 639px;
    }
  }

  /* По макету телефон в футере — mobile 40px (=Number/L mobile), desktop
     88px (=Number/XL desktop) — эта пара не совпадает ни с одним готовым
     стилем целиком, поэтому размер собран из двух уже определённых
     токенов (без новых значений), остальные свойства — как у .num-*. */
  .footer__phone {
    display: block;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: clamp(var(--fs-num-l-mobile), 9vw + 4px, var(--fs-num-xl-desktop));
    color: var(--color-text-inverse);
    line-height: 1;
    width: fit-content;
  }

  .footer__phone:hover {
    color: var(--color-accent-soft);
  }

  .footer__buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    width: 100%;
  }

  @media (min-width: 1024px) {
    .footer__buttons {
      width: 300px;
      flex-shrink: 0;
    }
  }

  .footer__btn {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-12);
    width: 100%;
    padding: var(--space-16) var(--space-20);
    border-radius: var(--radius-pill);
    color: var(--color-text-inverse);
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  @media (min-width: 1024px) {
    .footer__btn {
      padding: var(--space-16) var(--space-32);
    }
  }

  .footer__btn--primary {
    background: var(--color-accent-primary);
  }

  .footer__btn--primary:hover {
    background: var(--color-accent-hover);
  }

  .footer__btn--outline {
    border: 1px solid var(--color-text-inverse);
  }

  .footer__btn--outline:hover {
    border-color: var(--color-accent-soft);
    color: var(--color-accent-soft);
  }

  /* ===== Разделитель ===== */

  .footer__divider {
    width: 100%;
    height: 1px;
    background: var(--color-text-inverse);
    opacity: 0.12;
  }

  /* ===== Колонки ссылок ===== */

  .footer__columns {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-24);
    width: 100%;
  }

  @media (min-width: 1024px) {
    .footer__columns {
      flex-wrap: nowrap;
      gap: var(--space-40);
    }
  }

  .footer__column {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    width: calc(50% - var(--space-12));
  }

  @media (min-width: 1024px) {
    .footer__column {
      width: auto;
      flex: 1 0 0;
      min-width: 0;
    }
  }

  .footer__column--contacts {
    width: 100%;
    gap: var(--space-20);
  }

  @media (min-width: 1024px) {
    .footer__column--contacts {
      width: auto;
    }
  }

  .footer__column-title {
    color: var(--color-text-inverse);
    opacity: 0.5;
  }

  .footer__column-list {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  /* Анимация подчёркивания — тот же приём, что у .header__link в
     Header.astro (линия растёт от центра к краям), только цвет — бежевый
     (text/inverse), а не accent/primary: ссылки лежат на тёмном фоне. */
  .footer__column-link {
    display: inline-block;
    position: relative;
    width: fit-content;
    max-width: 100%;
    color: var(--color-text-inverse);
    opacity: 0.88;
    transition: opacity 0.15s ease;
  }

  .footer__column-link::before {
    content: '';
    width: 0;
    height: 1px;
    border-radius: 2px;
    background-color: var(--color-text-inverse);
    position: absolute;
    bottom: -2px;
    left: 50%;
    transition: width 0.3s ease, left 0.3s ease;
  }

  .footer__column-link:hover {
    opacity: 1;
  }

  .footer__column-link:hover::before {
    width: 100%;
    left: 0;
  }

  .footer__contact-block {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .footer__contact-primary {
    color: var(--color-text-inverse);
    opacity: 0.88;
  }

  .footer__contact-link {
    position: relative;
    width: fit-content;
    transition: opacity 0.15s ease;
  }

  .footer__contact-link::before {
    content: '';
    width: 0;
    height: 1px;
    border-radius: 2px;
    background-color: var(--color-text-inverse);
    position: absolute;
    bottom: -2px;
    left: 50%;
    transition: width 0.3s ease, left 0.3s ease;
  }

  .footer__contact-link:hover {
    opacity: 1;
  }

  .footer__contact-link:hover::before {
    width: 100%;
    left: 0;
  }

  .footer__contact-secondary {
    color: var(--color-text-inverse);
    opacity: 0.45;
  }

  /* ===== Юридическая строка ===== */

  .footer__legal {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    width: 100%;
  }

  @media (min-width: 1024px) {
    .footer__legal {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      gap: var(--space-24);
    }
  }

  .footer__brand {
    display: flex;
  }

  .footer__logo {
    display: block;
  }

  .footer__legal-text {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    width: 100%;
    color: var(--color-text-inverse);
  }

  @media (min-width: 1024px) {
    .footer__legal-text {
      align-items: flex-end;
      width: auto;
    }
  }

  .footer__legal-docs {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    width: 100%;
  }

  @media (min-width: 1024px) {
    .footer__legal-docs {
      flex-direction: row;
      gap: var(--space-24);
      width: auto;
    }
  }

  .footer__legal-link {
    display: inline-block;
    position: relative;
    color: var(--color-text-inverse);
    opacity: 0.45;
    transition: opacity 0.15s ease;
  }

  .footer__legal-link::before {
    content: '';
    width: 0;
    height: 1px;
    border-radius: 2px;
    background-color: var(--color-text-inverse);
    position: absolute;
    bottom: -2px;
    left: 50%;
    transition: width 0.3s ease, left 0.3s ease;
  }

  .footer__legal-link:hover {
    opacity: 0.7;
  }

  .footer__legal-link:hover::before {
    width: 100%;
    left: 0;
  }

  .footer__legal-copy {
    color: var(--color-text-inverse);
    opacity: 0.45;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer__column-link::before,
    .footer__contact-link::before,
    .footer__legal-link::before {
      transition: none;
    }

    /* Без эффекта «футер под контентом» — обычный футер в конце потока
       (скрипт в Base.astro для reduced-motion не выставляет .footer-spacer,
       так что лишнего пустого места под ним не остаётся) */
    .footer {
      position: static;
    }
  }
</style>
