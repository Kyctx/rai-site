---
// 09 · Benefits — Пособия. Desktop 198:3176, mobile 214:4238. Тёмная секция.
// Слева — список «способов сэкономить»: один пункт раскрыт (описание видно),
// остальные свёрнуты — клик по заголовку раскрывает его и сворачивает
// остальные (см. rai-handoff.md → 6. Интерактив: «аккордеон слева
// раскрывает описание»). Справа — карточка с суммой пособия, чек-лист
// документов и предупреждение о мошенниках.
import Icon from '@components/Icon.astro';
import Button from '@components/Button.astro';
import prices from '@data/prices.json';

const { benefit } = prices;

// Дата — из prices.json (benefit.validFrom), форматируем в "1 февраля 2026 года"
const months = ['января', 'февраля', 'марта', 'апреля', 'мая', 'июня', 'июля', 'августа', 'сентября', 'октября', 'ноября', 'декабря'];
const validFromDate = new Date(benefit.validFrom);
const validFromText = `${validFromDate.getDate()} ${months[validFromDate.getMonth()]} ${validFromDate.getFullYear()} года`;

// В макете (198:3176) текст-описание есть только у первого пункта — у
// «Компенсация ветеранам и военным», «Бесплатное место на кладбище» и
// «Рассрочка без переплаты» слоя с описанием нет вообще (не проработано в
// Figma). По просьбе заказчика ниже — демонстрационные тексты для этих
// трёх пунктов, заменить на согласованные перед запуском (см. CLAUDE.md →
// «Заглушки»).
const ways = [
  {
    id: 'burial-benefit',
    title: 'Пособие на погребение',
    description: 'Положено тому, кто организовал похороны. Подадим заявление в Соцфонд в тот же день: решение — за 1 рабочий день, деньги — в течение 3 рабочих дней.',
  },
  {
    id: 'veterans',
    title: 'Компенсация ветеранам и военным',
    description: 'Если умерший был военнослужащим, ветераном боевых действий или пенсионером Минобороны — родным положена отдельная выплата. Поможем определить размер и собрать документы.',
  },
  {
    id: 'cemetery-plot',
    title: 'Бесплатное место на кладбище',
    description: 'На муниципальном кладбище для погребения предоставляется бесплатный участок. Согласуем место и оформим документы через администрацию кладбища.',
  },
  {
    id: 'installment',
    title: 'Рассрочка без переплаты',
    description: 'Если пособия не хватает на всю сумму, остаток можно разбить на части без процентов и скрытых комиссий — сроки согласуем индивидуально.',
  },
];

const documents = [
  'Паспорт того, кто организует похороны',
  'Свидетельство о смерти из ЗАГСа — остальное Соцфонд запросит сам',
  'Реквизиты карты для перечисления',
];

const warnings = [
  'звонят сами и предлагают «лучшую цену»',
  'просят предоплату до договора',
  'торопят с решением прямо у двери',
];
---

<section id="benefits" aria-labelledby="benefits-title" class="section section--dark benefits">
  <div class="container benefits__inner">
    <div class="benefits__ways">
      <div class="benefits__heading">
        <p class="eyebrow">Сэкономим, где можно</p>
        <h2 id="benefits-title" class="h2">
          Часть расходов вернёт государство — <em>мы всё оформим</em>
        </h2>
      </div>

      <ul class="benefits__accordion" data-benefits-accordion>
        {ways.map((way, index) => (
          <li class:list={['benefits__item', { 'benefits__item--open': index === 0 }]} data-benefits-item>
            <button
              type="button"
              class="benefits__item-toggle"
              id={`benefits-toggle-${way.id}`}
              aria-expanded={index === 0 ? 'true' : 'false'}
              aria-controls={`benefits-desc-${way.id}`}
            >
              <span class="h4 benefits__item-title">{way.title}</span>
            </button>
            <div
              id={`benefits-desc-${way.id}`}
              role="region"
              aria-labelledby={`benefits-toggle-${way.id}`}
              class="body-m benefits__item-desc"
              hidden={index !== 0}
            >
              <p>{way.description}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>

    <div class="benefits__amount">
      <div class="benefits__card">
        <p class="label-m benefits__card-label">Пособие на погребение с {validFromText}</p>
        <p class="num-xl benefits__card-total">{benefit.display.toLocaleString('ru-RU')} ₽</p>
        <p class="body-s benefits__card-lead">Что понадобится — остальное соберёт агент:</p>

        <ul class="benefits__docs">
          {documents.map((doc) => (
            <li class="benefits__doc">
              <Icon name="check" size={18} class="benefits__doc-icon" />
              <p class="body-m benefits__doc-text">{doc}</p>
            </li>
          ))}
        </ul>

        <Button variant="primary" size="m" class="benefits__cta" data-goal="call_click">
          <span class="benefits__cta-text benefits__cta-text--full">Оформить пособие вместе с агентом</span>
          <span class="benefits__cta-text benefits__cta-text--short">Оформить пособие с агентом</span>
        </Button>
      </div>

      <div class="benefits__warning">
        <div class="benefits__warning-head">
          <Icon name="alert" size={18} class="benefits__warning-icon" />
          <p class="label-m benefits__warning-title">Будьте осторожны, если вам</p>
        </div>
        {warnings.map((line) => (
          <p class="body-s benefits__warning-line">— {line}</p>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .benefits__inner {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }

  @media (min-width: 1024px) {
    .benefits__inner {
      flex-direction: row;
      align-items: flex-start;
      gap: var(--space-48);
    }
  }

  /* ===== Слева: заголовок + аккордеон ===== */

  .benefits__ways {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    width: 100%;
  }

  @media (min-width: 1024px) {
    .benefits__ways {
      flex: 1 1 0;
      min-width: 0;
      gap: var(--space-40);
    }
  }

  .benefits__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .benefits__heading .h2 {
    max-width: 620px;
  }

  .benefits__accordion {
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .benefits__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    width: 100%;
    padding: var(--space-20) 0 var(--space-20) var(--space-24);
    border-left: 1px solid var(--color-text-inverse);
    transition: border-color 0.2s ease;
  }

  .benefits__item--open {
    border-left: 2px solid var(--color-accent-soft);
    padding-left: calc(var(--space-24) - 1px);
  }

  /* Свёрнутый пункт кликабелен целиком — при наведении полоса слева и
     заголовок чуть светлеют, как подсказка, что можно раскрыть */
  .benefits__item:not(.benefits__item--open):hover {
    border-left-color: var(--color-accent-soft);
  }

  .benefits__item-toggle {
    display: block;
    width: 100%;
    text-align: left;
  }

  .benefits__item-title {
    color: var(--color-text-inverse);
    opacity: 0.45;
    transition: opacity 0.2s ease;
  }

  .benefits__item:not(.benefits__item--open):hover .benefits__item-title {
    opacity: 0.75;
  }

  .benefits__item--open .benefits__item-title {
    opacity: 1;
  }

  .benefits__item-desc {
    color: var(--color-text-inverse);
    opacity: 0.7;
  }

  .benefits__item-desc[hidden] {
    display: none;
  }

  /* ===== Справа: карточка суммы + предупреждение ===== */

  .benefits__amount {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
    width: 100%;
  }

  @media (min-width: 1024px) {
    .benefits__amount {
      width: 500px;
      flex-shrink: 0;
    }
  }

  .benefits__card {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    width: 100%;
    padding: var(--space-24);
    background: var(--color-bg-surface);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 1024px) {
    .benefits__card {
      padding: var(--space-40);
    }
  }

  .benefits__card-label {
    color: var(--color-text-secondary);
  }

  .benefits__card-total {
    color: var(--color-text-primary);
  }

  .benefits__card-lead {
    color: var(--color-text-secondary);
  }

  .benefits__docs {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    width: 100%;
  }

  .benefits__doc {
    display: flex;
    align-items: flex-start;
    gap: var(--space-12);
  }

  :global(.benefits__doc-icon) {
    flex-shrink: 0;
    margin-top: 2px;
    color: var(--color-text-primary);
  }

  .benefits__doc-text {
    color: var(--color-text-primary);
  }

  .benefits__cta {
    width: 100%;
  }

  .benefits__cta-text--full {
    display: none;
  }

  @media (min-width: 1024px) {
    .benefits__cta-text--short {
      display: none;
    }

    .benefits__cta-text--full {
      display: inline;
    }
  }

  .benefits__warning {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    width: 100%;
    padding: var(--space-24) var(--space-20);
    border: 1px solid var(--color-text-inverse);
    border-radius: var(--radius-lg);
  }

  @media (min-width: 1024px) {
    .benefits__warning {
      padding: var(--space-24) var(--space-32);
    }
  }

  .benefits__warning-head {
    display: flex;
    align-items: center;
    gap: var(--space-12);
  }

  :global(.benefits__warning-icon) {
    flex-shrink: 0;
    color: var(--color-text-inverse);
  }

  .benefits__warning-title {
    color: var(--color-text-inverse);
  }

  .benefits__warning-line {
    color: var(--color-text-inverse);
    opacity: 0.7;
  }
</style>

<script>
  // Аккордеон слева — раскрыт всегда один пункт (по умолчанию первый),
  // клик по заголовку раскрывает его и сворачивает остальные.
  const root = document.querySelector('.benefits');
  if (root) {
    const items = Array.from(root.querySelectorAll<HTMLLIElement>('[data-benefits-item]'));

    const activate = (index: number) => {
      items.forEach((item, i) => {
        const open = i === index;
        const toggle = item.querySelector<HTMLButtonElement>('.benefits__item-toggle');
        const panel = item.querySelector<HTMLElement>('.benefits__item-desc');
        item.classList.toggle('benefits__item--open', open);
        toggle?.setAttribute('aria-expanded', String(open));
        if (panel) panel.hidden = !open;
      });
    };

    items.forEach((item, index) => {
      item.querySelector('.benefits__item-toggle')?.addEventListener('click', () => activate(index));
    });
  }
</script>
