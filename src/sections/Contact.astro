---
// 12 · Contact — Заявка и контакты. Desktop 198:3288, mobile 214:4350.
// Карточка в две части: тёмная (контакты) + светлая (форма). Desktop —
// рядом, mobile — друг под другом (без зазора, общая карточка).
// Переключатель способа связи — два визуально разных контрола (desktop:
// сегменты radius/md в ряд; mobile: единая пилюля с паддингом), но одно
// состояние на двоих — держим в синхроне через JS, как поля/шторки
// в Calculator.astro. Отправка — POST на /api/lead.php (см. CLAUDE.md);
// сам файл ещё не создан (это отдельная backend-задача), поэтому пока
// запрос будет падать в 404 — что и должно показывать состояние «ошибка».
import Icon from '@components/Icon.astro';
import Button from '@components/Button.astro';
import Input from '@components/Input.astro';
import Checkbox from '@components/Checkbox.astro';
import site from '@data/site.json';

// BASE_URL учитывает /rai-site/ на GitHub Pages (см. astro.config.mjs).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const telHref = `tel:${site.phone.tel}`;

const channels = [
  { id: 'call', label: 'Звонок', labelDesktop: 'Позвонить' },
  { id: 'telegram', label: 'Telegram', labelDesktop: 'Telegram' },
  { id: 'max', label: 'MAX', labelDesktop: 'MAX' },
];

const contactBlocks = [
  { title: 'Круглосуточная линия', value: site.phone.display, note: 'отвечаем за 40 секунд', href: telHref },
  { title: 'Написать', value: 'Telegram, MAX, WhatsApp', note: 'если сейчас тяжело говорить' },
  { title: 'Офис', value: site.address.text, note: site.address.hours },
];
---

<section id="contact" aria-labelledby="contact-title" class="section contact">
  <div class="container contact__inner">
    <div class="contact__card">
      <!-- ===== Слева/сверху: контакты ===== -->
      <div class="contact__info">
        <div class="contact__heading">
          <h2 id="contact-title" class="h2">
            Оставьте номер — <em>перезвоним и всё объясним</em>
          </h2>
          <p class="body-m contact__lead">Перезвоним за 5 минут. Бесплатно и ни к чему не обязывает.</p>
        </div>

        <div class="contact__blocks">
          {contactBlocks.map((block) => (
            <div class="contact__block">
              <p class="h5 contact__block-title">{block.title}</p>
              {block.href ? (
                <a href={block.href} class="body-l-strong contact__block-value" data-goal="call_click">{block.value}</a>
              ) : (
                <p class="body-l-strong contact__block-value">{block.value}</p>
              )}
              <p class="body-s contact__block-note">{block.note}</p>
            </div>
          ))}
        </div>
      </div>

      <!-- ===== Справа/снизу: форма ===== -->
      <form class="contact__form" novalidate data-contact-form>
        <!-- Всё обычное содержимое формы — в одном контейнере, чтобы состояния
             успех/ошибка переключались одним hidden, а не полем за полем -->
        <div class="contact__fields" data-contact-fields>
          <p class="label-m contact__form-title">Как с вами связаться</p>

          <!-- Способ связи: desktop — сегменты в ряд -->
          <div class="contact__channel contact__channel--desktop" role="radiogroup" aria-label="Способ связи">
            {channels.map((c, i) => (
              <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-channel-id={c.id} class:list={['contact__channel-item', { 'contact__channel-item--active': i === 0 }]}>
                <span class="label-m">{c.labelDesktop}</span>
              </button>
            ))}
          </div>

          <!-- Способ связи: mobile — единая пилюля -->
          <div class="contact__channel contact__channel--mobile" role="radiogroup" aria-label="Способ связи">
            {channels.map((c, i) => (
              <button type="button" role="radio" aria-checked={i === 0 ? 'true' : 'false'} data-channel-id={c.id} class:list={['contact__channel-pill', { 'contact__channel-pill--active': i === 0 }]}>
                <span class="label-m">{c.label}</span>
              </button>
            ))}
          </div>

          <Input label="Как к вам обращаться" name="name" placeholder="Имя" autocomplete="name" />

          <Input label="Телефон" name="phone" type="tel" inputmode="tel" autocomplete="tel" required data-phone-input />

          <!-- Honeypot: реальные пользователи и скринридеры его не видят и не
               заполняют, простые боты — заполняют всё подряд -->
          <div class="contact__honeypot" aria-hidden="true">
            <label for="contact-website">Website</label>
            <input type="text" id="contact-website" name="website" tabindex="-1" autocomplete="off" />
          </div>

          <Checkbox id="contact-consent" name="consent" required>
            Соглашаюсь с <a href={`${base}/privacy`}>политикой обработки персональных данных</a> и <a href={`${base}/consent`}>согласием на обработку</a>
          </Checkbox>

          <div class="contact__buttons">
            <Button type="submit" variant="primary" size="m" icon="phone" iconPosition="start" class="contact__submit" data-submit-btn>
              <span data-submit-label>Жду звонка</span>
            </Button>
            <Button href={site.address.yandexMapsUrl} variant="outline" size="m" icon="pin" iconPosition="start" class="contact__route">
              <span class="contact__route-text--full">Построить маршрут в Яндекс Картах</span>
              <span class="contact__route-text--short">Маршрут в Яндекс Картах</span>
            </Button>
          </div>
        </div>

        <!-- Состояния отправки: показываем вместо формы, форма скрывается -->
        <div class="contact__status" data-status="success" hidden aria-live="polite">
          <Icon name="check" size={28} class="contact__status-icon" />
          <p class="title contact__status-title">Заявка отправлена</p>
          <p class="body-m contact__status-text">Перезвоним в течение 5 минут — оставайтесь на связи.</p>
        </div>

        <div class="contact__status" data-status="error" hidden aria-live="assertive">
          <Icon name="alert" size={28} class="contact__status-icon contact__status-icon--error" />
          <p class="title contact__status-title">Не получилось отправить</p>
          <p class="body-m contact__status-text">
            Позвоните нам напрямую: <a href={telHref} class="contact__status-phone" data-goal="call_click">{site.phone.display}</a>
          </p>
          <button type="button" class="body-s contact__status-retry" data-retry-btn>Попробовать ещё раз</button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .contact__card {
    display: flex;
    flex-direction: column;
    width: 100%;
    background: var(--color-bg-surface);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-lg);
    overflow: clip;
  }

  @media (min-width: 1024px) {
    .contact__card {
      flex-direction: row;
      align-items: stretch;
    }
  }

  /* ===== Контакты (тёмная часть) ===== */

  .contact__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    width: 100%;
    padding: var(--space-24);
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
  }

  @media (min-width: 1024px) {
    .contact__info {
      width: 560px;
      flex-shrink: 0;
      gap: var(--space-40);
      padding: var(--space-56);
    }
  }

  .contact__heading {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  /* Тёмный фон — только у .contact__info, не у всей секции (справа светлая
     форма), поэтому общее правило ".section--dark em" сюда не достаёт —
     красим акцент в заголовке отдельно (тот же accent/soft, что и в других
     тёмных секциях: Benefits, Process). */
  .contact__info .h2 em {
    color: var(--color-accent-soft);
  }

  @media (min-width: 1024px) {
    .contact__heading .h2 {
      max-width: 450px;
    }
  }

  .contact__lead {
    opacity: 0.7;
  }

  .contact__blocks {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    width: 100%;
  }

  .contact__block {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .contact__block-title {
    color: var(--color-accent-soft);
  }

  .contact__block-value {
    color: var(--color-text-inverse);
  }

  a.contact__block-value:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .contact__block-note {
    color: var(--color-text-inverse);
    opacity: 0.55;
  }

  /* ===== Форма (светлая часть) ===== */

  .contact__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    width: 100%;
    padding: var(--space-24);
  }

  @media (min-width: 1024px) {
    .contact__form {
      flex: 1 0 0;
      min-width: 0;
      padding: var(--space-56);
    }
  }

  .contact__fields {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
    width: 100%;
  }

  /* [hidden] сам по себе проигрывает display:flex выше по специфичности —
     та же история, что у .calculator__summary-line--wake[hidden] */
  .contact__fields[hidden] {
    display: none;
  }

  .contact__form-title {
    color: var(--color-text-primary);
  }

  /* ===== Способ связи: desktop — сегменты в ряд ===== */

  .contact__channel--desktop {
    display: none;
  }

  @media (min-width: 1024px) {
    .contact__channel--desktop {
      display: flex;
      gap: var(--space-8);
      width: 100%;
    }
  }

  .contact__channel-item {
    flex: 1 0 0;
    padding: var(--space-16);
    background: var(--color-bg-page);
    border-radius: var(--radius-md);
    color: var(--color-text-primary);
    text-align: center;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .contact__channel-item--active {
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
  }

  .contact__channel-item:not(.contact__channel-item--active):hover {
    background: var(--color-border-default);
  }

  /* ===== Способ связи: mobile — единая пилюля ===== */

  .contact__channel--mobile {
    display: flex;
    gap: var(--space-4);
    padding: var(--space-4);
    width: 100%;
    background: var(--color-bg-page);
    border-radius: var(--radius-pill);
  }

  @media (min-width: 1024px) {
    .contact__channel--mobile {
      display: none;
    }
  }

  .contact__channel-pill {
    flex: 1 0 0;
    padding-block: var(--space-12);
    border-radius: var(--radius-pill);
    color: var(--color-text-primary);
    text-align: center;
    transition: background-color 0.2s ease, color 0.2s ease;
  }

  .contact__channel-pill--active {
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
  }

  /* ===== Honeypot ===== */

  .contact__honeypot {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }

  /* ===== Кнопки ===== */

  .contact__buttons {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
    width: 100%;
  }

  :global(.contact__submit) {
    width: 100%;
  }

  :global(.contact__route) {
    width: 100%;
    border-color: var(--color-text-primary);
  }

  /* Mobile — короткий текст (rai-handoff.md 5a), desktop — полный (198:3288) */
  .contact__route-text--full {
    display: none;
  }

  @media (min-width: 1024px) {
    .contact__route-text--full {
      display: inline;
    }

    .contact__route-text--short {
      display: none;
    }
  }

  /* ===== Состояния отправки ===== */

  .contact__status {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-12);
    width: 100%;
    padding: var(--space-24);
    background: var(--color-bg-page);
    border-radius: var(--radius-md);
  }

  .contact__status[hidden] {
    display: none;
  }

  :global(.contact__status-icon) {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    padding: 10px;
    background: var(--color-accent-soft);
    color: var(--color-accent-primary);
    border-radius: var(--radius-pill);
  }

  /* В системе нет отдельного «цвета ошибки» (и бренд сознательно избегает
     тревожных сигналов, см. CLAUDE.md → «Чего не делать») — состояние
     отличается иконкой и текстом, не цветом; фон/цвет те же токены,
     что у нейтрального предупреждения в Benefits.astro. */
  :global(.contact__status-icon--error) {
    background: var(--color-bg-secondary);
    color: var(--color-text-primary);
  }

  .contact__status-title {
    color: var(--color-text-primary);
  }

  .contact__status-text {
    color: var(--color-text-secondary);
  }

  .contact__status-phone {
    color: var(--color-accent-primary);
    font-weight: 500;
  }

  .contact__status-phone:hover {
    text-decoration: underline;
  }

  .contact__status-retry {
    color: var(--color-accent-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
</style>

<script>
  import IMask from 'imask';

  const root = document.querySelector<HTMLElement>('.contact');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-contact-form]');
    const fields = root.querySelector<HTMLElement>('[data-contact-fields]');
    const phoneInput = root.querySelector<HTMLInputElement>('[data-phone-input]');
    const submitBtn = root.querySelector<HTMLButtonElement>('[data-submit-btn]');
    const submitLabel = root.querySelector<HTMLElement>('[data-submit-label]');
    const statusBlocks = {
      success: root.querySelector<HTMLElement>('[data-status="success"]'),
      error: root.querySelector<HTMLElement>('[data-status="error"]'),
    };
    const retryBtn = root.querySelector<HTMLButtonElement>('[data-retry-btn]');

    // ===== Маска телефона =====
    let mask: ReturnType<typeof IMask> | null = null;
    if (phoneInput) {
      mask = IMask(phoneInput, { mask: '+7 (000) 000-00-00', lazy: false, placeholderChar: '_' });
    }

    // ===== Способ связи: два визуально разных контрола, одно состояние =====
    // Иконка кнопки не меняется (в макете нет состояний для Telegram/MAX) —
    // меняется только текст, чтобы отражать выбранный способ связи.
    const channelMeta: Record<string, { label: string }> = {
      call: { label: 'Жду звонка' },
      telegram: { label: 'Жду сообщения в Telegram' },
      max: { label: 'Жду сообщения в MAX' },
    };

    let channel = 'call';

    const applyChannel = () => {
      root.querySelectorAll<HTMLButtonElement>('[data-channel-id]').forEach((btn) => {
        const active = btn.dataset.channelId === channel;
        btn.setAttribute('aria-checked', String(active));
        btn.classList.toggle('contact__channel-item--active', active && btn.classList.contains('contact__channel-item'));
        btn.classList.toggle('contact__channel-pill--active', active && btn.classList.contains('contact__channel-pill'));
      });
      const meta = channelMeta[channel];
      if (submitLabel && meta) submitLabel.textContent = meta.label;
    };

    root.querySelectorAll<HTMLButtonElement>('[data-channel-id]').forEach((btn) => {
      btn.addEventListener('click', () => {
        channel = btn.dataset.channelId ?? 'call';
        applyChannel();
      });
    });

    applyChannel();

    // ===== Отправка =====
    const showStatus = (name: keyof typeof statusBlocks | null) => {
      Object.entries(statusBlocks).forEach(([key, el]) => {
        if (el) el.hidden = key !== name;
      });
      if (fields) fields.hidden = name !== null;
    };

    retryBtn?.addEventListener('click', () => showStatus(null));

    form?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!form.reportValidity()) return;

      const digits = mask?.unmaskedValue ?? '';
      if (digits.length !== 10) {
        phoneInput?.focus();
        return;
      }

      const formData = new FormData(form);
      const payload = {
        name: String(formData.get('name') ?? ''),
        phone: `7${digits}`,
        channel,
        source: 'contact',
        consent: formData.get('consent') === 'on',
        website: String(formData.get('website') ?? ''),
        // TODO: подключить Yandex SmartCaptcha, когда появится site key —
        // см. CLAUDE.md → «Форма: public/api/lead.php».
        captcha_token: '',
      };

      if (submitBtn) submitBtn.disabled = true;
      const originalLabel = submitLabel?.textContent ?? '';
      if (submitLabel) submitLabel.textContent = 'Отправляем…';

      try {
        const response = await fetch('/api/lead.php', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json().catch(() => ({ ok: false }));
        if (!response.ok || !result.ok) throw new Error(result.error ?? 'request failed');
        showStatus('success');
      } catch {
        showStatus('error');
      } finally {
        if (submitBtn) submitBtn.disabled = false;
        if (submitLabel) submitLabel.textContent = originalLabel;
      }
    });
  }
</script>
