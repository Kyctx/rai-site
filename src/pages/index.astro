---
// Главная страница. Секции подключаются по мере вёрстки (см. таблицу в CLAUDE.md).
import Base from '@layouts/Base.astro';
import Header from '@sections/Header.astro';
import Hero from '@sections/Hero.astro';
import Services from '@sections/Services.astro';
import Trust from '@sections/Trust.astro';
import Process from '@sections/Process.astro';
import Pricing from '@sections/Pricing.astro';
import Agents from '@sections/Agents.astro';
import Reviews from '@sections/Reviews.astro';
import Calculator from '@sections/Calculator.astro';
import Benefits from '@sections/Benefits.astro';
import Faq from '@sections/Faq.astro';
import Guide from '@sections/Guide.astro';
import Footer from '@sections/Footer.astro';
---

<Base title="Рай — ритуальные услуги в Нижнем Новгороде" description="Круглосуточная ритуальная служба: организация похорон, кремация, перевозка, памятники. Приедем в течение часа.">
  <Fragment slot="header">
    <Header />
  </Fragment>

  <div id="top"></div>
  <Hero />
  <Services />
  <Trust />
  <Process />
  <Pricing />
  <Agents />
  <Reviews />
  <Calculator />
  <Benefits />
  <Faq />
  <Guide />

  <Footer slot="footer" />
</Base>
