---
// Базовый layout: <head>, подключение шрифтов/стилей, Яндекс.Метрика (только в production).
// Header и Footer подключаются здесь же после вёрстки соответствующих секций (00 и 13).
import site from '@data/site.json';

interface Props {
  title: string;
  description?: string;
}

const { title, description } = Astro.props;
const isProd = import.meta.env.PROD;
const metrikaId = import.meta.env.PUBLIC_YANDEX_METRIKA_ID;

// Пути к шрифтам и favicon строим от BASE_URL — на GitHub Pages сайт лежит
// в подпути (/rai-site/), на проде — в корне домена (см. astro.config.mjs).
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const font = (file: string) => `${base}/fonts/${file}`;

const fontFaceCss = `
  @font-face {
    font-family: "Cormorant Garamond";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("${font('cormorant-garamond-500-cyrillic-v2.woff2')}") format("woff2");
    unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116, U+20BD;
  }
  @font-face {
    font-family: "Cormorant Garamond";
    font-style: normal;
    font-weight: 500;
    font-display: swap;
    src: url("${font('cormorant-garamond-500-latin.woff2')}") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F, U+20AC, U+2122;
  }
  @font-face {
    font-family: "Cormorant Garamond";
    font-style: italic;
    font-weight: 400;
    font-display: swap;
    src: url("${font('cormorant-garamond-400italic-cyrillic.woff2')}") format("woff2");
    unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
  }
  @font-face {
    font-family: "Cormorant Garamond";
    font-style: italic;
    font-weight: 400;
    font-display: swap;
    src: url("${font('cormorant-garamond-400italic-latin.woff2')}") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F, U+20AC, U+2122;
  }
  /* Курсив 500 использует то же начертание, что и 400 (у Cormorant Garamond
     один статический italic-файл на оба веса — см. public/fonts). */
  @font-face {
    font-family: "Cormorant Garamond";
    font-style: italic;
    font-weight: 500;
    font-display: swap;
    src: url("${font('cormorant-garamond-400italic-cyrillic.woff2')}") format("woff2");
    unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
  }
  @font-face {
    font-family: "Cormorant Garamond";
    font-style: italic;
    font-weight: 500;
    font-display: swap;
    src: url("${font('cormorant-garamond-400italic-latin.woff2')}") format("woff2");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F, U+20AC, U+2122;
  }
  /* Onest — вариативный шрифт (ось wght покрывает 400–600 одним файлом) */
  @font-face {
    font-family: "Onest";
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
    src: url("${font('onest-variable-cyrillic.woff2')}") format("woff2-variations");
    unicode-range: U+0301, U+0400-045F, U+0490-0491, U+04B0-04B1, U+2116;
  }
  @font-face {
    font-family: "Onest";
    font-style: normal;
    font-weight: 400 600;
    font-display: swap;
    src: url("${font('onest-variable-latin.woff2')}") format("woff2-variations");
    unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+2000-206F, U+20AC, U+2122;
  }
`;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <title>{title} · {site.brand}</title>
    {description && <meta name="description" content={description} />}

    <link rel="preload" href={font('cormorant-garamond-500-cyrillic-v2.woff2')} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={font('onest-variable-cyrillic.woff2')} as="font" type="font/woff2" crossorigin />

    <style is:global set:html={fontFaceCss}></style>
    <style is:global>
      @import "@styles/tokens.css";
      @import "@styles/base.css";
    </style>

    {isProd && metrikaId && (
      <script is:inline define:vars={{ metrikaId }}>
        (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
        m[i].l=1*new Date();
        for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
        k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
        (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");
        ym(metrikaId, "init", { clickmap: true, trackLinks: true, accurateTrackBounce: true });
      </script>
    )}
  </head>
  <body>
    <slot name="header" />
    <main>
      <slot />
    </main>
    <!-- Пустая распорка нужной высоты — вне <main>, у которого сплошной
         фон на всю высоту его блока (см. base.css): будь спейсер внутри
         main, этот фон закрашивал бы и его, и зафиксированный футер под
         ним так и не открывался бы, сколько ни скролль. -->
    <div class="footer-spacer" aria-hidden="true"></div>
    <slot name="footer" />

    <!-- is:inline + без defer: выполняется синхронно сразу здесь, до первой
         отрисовки страницы браузером — класс .reveal (opacity:0) навешен
         раньше paint, поэтому уже видимые на экране секции не мигают.
         Обычный script type="module" (по умолчанию у Astro) выполняется
         с defer, то есть иногда уже после первого кадра — для anti-flicker
         скрипта это не подходит. -->
    <script is:inline>
      (function () {
        var sections = Array.prototype.slice.call(document.querySelectorAll('main > section'));
        // Первая секция (обычно Hero) видна сразу — её не анимируем, иначе
        // страница на открытии на миг мигает пустой.
        var first = sections.shift();
        if (first) first.classList.add('is-visible');
        if (!sections.length) return;

        if (!('IntersectionObserver' in window)) {
          sections.forEach(function (s) { s.classList.add('is-visible'); });
          return;
        }

        sections.forEach(function (s) { s.classList.add('reveal'); });

        var observer = new IntersectionObserver(
          function (entries) {
            entries.forEach(function (entry) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            });
          },
          { rootMargin: '0px 0px -10% 0px', threshold: 0.1 }
        );

        sections.forEach(function (s) { observer.observe(s); });
      })();
    </script>

    <!-- Футер зафиксирован внизу вьюпорта (position: fixed, см. Footer.astro)
         и лежит вне потока — .footer-spacer в конце main отвечает за то,
         чтобы страницу вообще можно было доскроллить настолько, чтобы его
         открыть; высота спейсера = высота футера, синхронизирует этот
         скрипт. is:inline без defer — чтобы высота была верной уже к
         первому скроллу, а не только после отрисовки. -->
    <script is:inline>
      (function () {
        var footer = document.querySelector('footer.footer');
        var spacer = document.querySelector('.footer-spacer');
        if (!footer || !spacer) return;

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        var sync = function () {
          spacer.style.height = footer.offsetHeight + 'px';
        };
        sync();

        if ('ResizeObserver' in window) {
          new ResizeObserver(sync).observe(footer);
        } else {
          window.addEventListener('resize', sync);
        }
      })();
    </script>
  </body>
</html>
