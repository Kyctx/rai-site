---
// Общий каркас страниц каталога: Base + шапка + подвал + оверлеи (тост, шторка списка, форма звонка).
import Base from '@layouts/Base.astro';
import Header from '@sections/Header.astro';
import Footer from '@sections/Footer.astro';
import Overlays from '@components/catalog/Overlays.astro';

interface Props {
  title: string;
  description?: string;
  fullTitle?: string;
}
---

<Base {...Astro.props} pageEnter>
  <Fragment slot="head"><slot name="head" /></Fragment>
  <Fragment slot="header">
    <Header />
  </Fragment>

  <slot />

  <Fragment slot="footer">
    <Footer />
    <Overlays />
  </Fragment>
</Base>
