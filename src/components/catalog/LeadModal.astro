---
// Форма звонка. Figma: «Форма — обратный звонок» 426:702 (desktop, модальное окно 560 px),
// 434:915 (mobile, шторка снизу с ручкой). Четыре состояния: заполнение, отправка, успех, ошибка.
// Логика и отправка в /api/lead.php — catalog.js; источники заявки: catalog-bar | product | saved-list.
import Button from '@components/Button.astro';
import Checkbox from '@components/Checkbox.astro';
import Icon from '@components/Icon.astro';
import site from '@data/site.json';
import { base } from '@lib/catalog';

const telHref = `tel:${site.phone.tel}`;
---

<dialog class="lead" id="lead-dialog" aria-labelledby="lead-title" data-state="form" data-api={`${base}/api/lead.php`}>
  <div class="lead__panel">
    <span class="lead__handle" aria-hidden="true"></span>

    <form class="lead__form" data-lead-form novalidate>
      <div class="lead__head">
        <h2 class="h3" id="lead-title">Перезвоним за 5 минут</h2>
        <button type="button" class="lead__close" data-dialog-close aria-label="Закрыть">
          <Icon name="close" size={24} />
        </button>
      </div>
      <p class="body-s lead__lead">Агент позвонит, обсудит ваш список и ответит на вопросы.<br />Это бесплатно и ни к чему не обязывает.</p>

      <div class="lead__alert" role="alert" data-lead-error hidden>
        <p class="body-s-strong lead__alert-title">Не получилось отправить заявку</p>
        <p class="body-s">
          Ваши данные и список сохранены — попробуйте ещё раз или позвоните нам:
          <a class="lead__alert-phone" href={telHref}>{site.phone.display}</a>, круглосуточно.
        </p>
      </div>

      <label class="lead__field">
        <span class="body-s lead__label">Как к вам обращаться</span>
        <input class="body-m lead__input" type="text" name="name" placeholder="Имя" autocomplete="given-name" maxlength="80" />
      </label>

      <label class="lead__field">
        <span class="body-s lead__label">Телефон</span>
        <input class="body-m lead__input" type="tel" name="phone" placeholder="+7 (___) ___-__-__" inputmode="tel" autocomplete="tel" required />
        <span class="body-s lead__error" data-field-error="phone"></span>
      </label>

      <p class="body-s lead__interest" data-lead-product hidden>Интересует: <strong data-lead-product-name></strong></p>

      <div class="lead__list" data-lead-list hidden>
        <p class="label-m lead__list-title">Передадим агенту ваш список</p>
        <ul class="lead__chips" data-lead-chips></ul>
      </div>

      <div class="lead__consent-wrap">
        <Checkbox id="lead-consent" name="consent" required>
          Согласен на <a href={`${base}/consent`} target="_blank" rel="noopener">обработку персональных данных</a>, с
          <a href={`${base}/privacy`} target="_blank" rel="noopener">политикой</a> ознакомлен
        </Checkbox>
        <span class="body-s lead__error" data-field-error="consent"></span>
      </div>

      <!-- Ловушка для ботов: человек это поле не видит и не заполняет -->
      <input class="sr-only" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />

      <Button type="submit" data-lead-submit data-label="Жду звонка">Жду звонка</Button>
      <p class="body-s lead__call">Или позвоните сами: <a href={telHref} data-goal="call_click">{site.phone.display}</a></p>
    </form>

    <div class="lead__done" data-lead-done hidden>
      <div class="lead__done-top">
        <span class="lead__done-icon"><Icon name="check" size={24} /></span>
        <button type="button" class="lead__close" data-dialog-close aria-label="Закрыть">
          <Icon name="close" size={24} />
        </button>
      </div>
      <h2 class="h3">Заявка принята</h2>
      <p class="body-m">Агент перезвонит в течение 5 минут на номер <span data-done-phone></span>.</p>
      <p class="body-s lead__done-list" data-done-list hidden></p>
      <Button variant="outline" size="l" data-dialog-close>Хорошо</Button>
    </div>
  </div>

  <template data-chip>
    <li class="lead__chip">
      <span class="body-s" data-chip-name></span>
      <button type="button" class="label-s lead__chip-x" data-chip-remove><Icon name="close" size={14} /></button>
    </li>
  </template>
</dialog>

<style>
  .lead {
    width: 100%;
    max-width: none;
    height: 100%;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: transparent;
    color: var(--color-text-primary);
    /* clip, а не hidden/auto: иначе браузер прокручивает само окно к автофокусу за краем экрана,
       пока шторка ещё выезжает снизу, — отсюда рывок при открытии */
    overflow: clip;
  }

  .lead::backdrop {
    background: color-mix(in srgb, var(--color-bg-inverse) 50%, transparent);
  }

  /* Затемнение появляется плавно, вместе с выезжающей шторкой */
  .lead[open]::backdrop {
    animation: lead-backdrop 0.28s ease;
  }

  @keyframes lead-backdrop {
    from {
      opacity: 0;
    }
  }

  /* Mobile 434:915 — шторка снизу с ручкой */
  .lead__panel {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    max-height: 94dvh;
    overflow-y: auto;
    padding: var(--space-12) var(--space-20) var(--space-24);
    border-radius: var(--radius-lg) var(--radius-lg) 0 0;
    background: var(--color-bg-page);
    animation: lead-up 0.28s ease;
  }

  .lead__handle {
    display: block;
    width: 40px;
    height: 4px;
    margin: 0 auto var(--space-16);
    border-radius: var(--radius-pill);
    background: var(--color-border-default);
  }

  .lead__form,
  .lead__done {
    display: flex;
    flex-direction: column;
    gap: var(--space-16);
  }

  .lead__form[hidden],
  .lead__done[hidden] {
    display: none;
  }

  .lead__head,
  .lead__done-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-16);
  }

  /* Mobile: окно закрывается свайпом вниз, тапом по фону и Esc — крестик не показываем,
     но оставляем для скринридеров и клавиатуры (визуально скрыт) */
  .lead__close {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    color: var(--color-text-secondary);
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
  }

  .lead__lead,
  .lead__label {
    color: var(--color-text-secondary);
  }

  .lead__alert {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--space-16) var(--space-20);
    border-radius: var(--radius-md);
    background: var(--color-feedback-error-soft);
  }

  .lead__alert[hidden] {
    display: none;
  }

  .lead__alert-title,
  .lead__alert-phone {
    color: var(--color-feedback-error);
  }

  .lead__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .lead__input {
    width: 100%;
    padding: var(--space-16);
    border: 1px solid var(--color-border-default);
    border-radius: var(--radius-md);
    background: var(--color-bg-surface);
    color: var(--color-text-primary);
  }

  .lead__input::placeholder {
    color: var(--color-text-secondary);
  }

  .lead__input:focus-visible {
    outline-offset: 0;
    border-color: var(--color-accent-primary);
  }

  .lead__input[aria-invalid='true'] {
    border-color: var(--color-feedback-error);
  }

  .lead__error {
    color: var(--color-feedback-error);
  }

  .lead__error:empty {
    display: none;
  }

  .lead__interest strong {
    font-weight: 500;
  }

  .lead__interest[hidden],
  .lead__list[hidden] {
    display: none;
  }

  .lead__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
    padding: var(--space-16);
    border-radius: var(--radius-md);
    background: var(--color-accent-soft);
  }

  .lead__list-title {
    color: var(--color-accent-primary);
  }

  .lead__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-8);
  }

  .lead__chip {
    display: flex;
    align-items: center;
    gap: var(--space-8);
    padding: var(--space-8) var(--space-12);
    border-radius: var(--radius-pill);
    background: var(--color-bg-surface);
  }

  .lead__chip-x {
    display: grid;
    place-items: center;
    color: var(--color-text-secondary);
  }

  .lead__consent-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .lead__consent-wrap :global(a) {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .lead__form :global([data-lead-submit]) {
    width: 100%;
  }

  .lead__form :global([data-lead-submit]:disabled) {
    opacity: 0.6;
    pointer-events: none;
  }

  .lead__call {
    text-align: center;
    color: var(--color-text-secondary);
  }

  .lead__call a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .lead__done-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: var(--radius-lg);
    background: var(--color-accent-soft);
    color: var(--color-accent-primary);
  }

  .lead__done-list {
    color: var(--color-text-secondary);
  }

  .lead__done-list[hidden] {
    display: none;
  }

  .lead__done :global(.btn) {
    width: 100%;
  }

  /* Desktop 426:702 — модальное окно 560 px по центру */
  @media (min-width: 768px) {
    /* Планшет и desktop: крестик виден */
    .lead__close {
      position: static;
      width: auto;
      height: auto;
      overflow: visible;
      clip: auto;
    }

    .lead__panel {
      top: 50%;
      left: 50%;
      right: auto;
      bottom: auto;
      width: 560px;
      max-width: calc(100% - var(--space-40));
      max-height: calc(100dvh - var(--space-40));
      padding: var(--space-40);
      border-radius: var(--radius-lg);
      box-shadow: var(--shadow-lg);
      transform: translate(-50%, -50%);
      animation-name: lead-fade;
    }

    .lead__handle {
      display: none;
    }

    .lead__form,
    .lead__done {
      gap: var(--space-20);
    }
  }

  @keyframes lead-up {
    from {
      transform: translateY(100%);
    }
  }

  @keyframes lead-fade {
    from {
      opacity: 0;
      transform: translate(-50%, calc(-50% + 12px));
    }
  }
</style>
