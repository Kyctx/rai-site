---
// Тёмная панель товара. Figma: «Панель товара» 426:3933 (Обычная / Отложено), mobile — 433:716.
// Состояние «Отложено» включает catalog.js (атрибут data-saved на кнопке закладки).
import Button from '@components/Button.astro';
import Icon from '@components/Icon.astro';
import { formatPrice, type Product } from '@lib/catalog';

interface Props {
  product: Product;
}

const { product } = Astro.props;
const perks = ['Оплата после, без предоплаты', 'Агента можно проверить по номеру'];
---

<div class="panel">
  <div class="panel__info">
    <div class="panel__head">
      <h1 class="h2 panel__title" id="product-title">{product.name}</h1>
      <div class="panel__price">
        <p class="num-l">{formatPrice(product.price)}</p>
        <p class="body-s panel__note">Цена фиксируется в договоре</p>
      </div>
    </div>
    <ul class="panel__perks">
      {perks.map((perk) => (
        <li>
          <Icon name="check" size={16} strokeWidth={1.6} />
          <span class="body-s panel__perk-text">{perk}</span>
        </li>
      ))}
    </ul>
  </div>

  <hr class="panel__line" />

  <div class="panel__actions">
    <Button size="l" data-open-lead="product" data-slug={product.slug}>Уточнить у агента</Button>
    <button type="button" class="panel__mark label-m" data-save-panel={product.slug} aria-pressed="false">
      <Icon name="bookmark" size={24} class="panel__icon panel__icon--off" />
      <Icon name="bookmark-filled" size={24} class="panel__icon panel__icon--on" />
      <span class="panel__mark-off">Отметить для агента</span>
      <span class="panel__mark-on">Отмечено · <u>открыть список</u> (<span data-saved-count>1</span>)</span>
    </button>
  </div>
</div>

<style>
  /* Mobile: на всю ширину, углы без скругления */
  .panel {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: var(--space-24);
    padding: var(--space-24);
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
  }

  .panel__info {
    display: flex;
    flex-direction: column;
    gap: var(--space-32);
  }

  .panel__head {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }

  .panel__note {
    opacity: 0.6;
  }

  .panel__perks {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }

  .panel__perks li {
    display: flex;
    align-items: center;
    gap: var(--space-8);
  }

  /* Прозрачность — только у текста, галка остаётся зелёной, как в макете (426:3887) */
  .panel__perk-text {
    opacity: 0.75;
  }

  .panel__perks :global(svg) {
    flex-shrink: 0;
    color: var(--color-accent-on-inverse);
  }

  .panel__line {
    width: 100%;
    height: 1px;
    margin: 0;
    border: 0;
    background: var(--color-text-inverse);
    opacity: 0.16;
  }

  .panel__actions {
    display: flex;
    flex-direction: column;
    gap: var(--space-12);
  }

  .panel__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-8);
    padding: var(--space-16) var(--space-24);
    border: 1px solid var(--color-text-inverse);
    border-radius: var(--radius-pill);
    color: var(--color-text-inverse);
    transition: border-color 0.2s ease, color 0.2s ease, background-color 0.2s ease;
  }

  .panel__mark:hover {
    border-color: var(--color-accent-on-inverse);
    color: var(--color-accent-on-inverse);
  }

  .panel__mark :global(.panel__icon--on),
  .panel__mark-on {
    display: none;
  }

  .panel__mark[data-saved] {
    background: var(--color-accent-on-inverse);
    border-color: var(--color-accent-on-inverse);
    color: var(--color-bg-inverse);
  }

  .panel__mark[data-saved]:hover {
    background: var(--color-text-inverse);
    border-color: var(--color-text-inverse);
    color: var(--color-bg-inverse);
  }

  .panel__mark[data-saved] :global(.panel__icon--off),
  .panel__mark[data-saved] .panel__mark-off {
    display: none;
  }

  .panel__mark[data-saved] :global(.panel__icon--on) {
    display: block;
  }

  .panel__mark[data-saved] .panel__mark-on {
    display: inline;
  }

  @media (min-width: 1024px) {
    .panel {
      width: 440px;
      padding: var(--space-40);
      gap: var(--space-32);
    }
  }
</style>
