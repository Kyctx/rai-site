---
// Кнопка (UI Kit «Рай»): variant Primary/Dark/Outline/Soft, size M/L.
// Primary — основное действие, остальные — второстепенные (см. описание компонента в Figma).
import Icon from '@components/Icon.astro';

interface Props {
  variant?: 'primary' | 'dark' | 'outline' | 'soft';
  size?: 'm' | 'l';
  icon?: string;
  iconPosition?: 'start' | 'end';
  href?: string;
  type?: 'button' | 'submit';
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const {
  variant = 'primary',
  size = 'm',
  icon,
  iconPosition = 'end',
  href,
  type = 'button',
  class: className,
  ...rest
} = Astro.props;

const Tag = href ? 'a' : 'button';
const iconSize = 20;
---

<Tag
  href={href}
  type={!href ? type : undefined}
  class:list={['btn', `btn--${variant}`, `btn--${size}`, 'pill-hover', className]}
  {...rest}
>
  {icon && iconPosition === 'start' && <Icon name={icon} size={iconSize} />}
  <span class="label-m"><slot /></span>
  {icon && iconPosition === 'end' && <Icon name={icon} size={iconSize} />}
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-12);
    border-radius: var(--radius-pill);
    white-space: nowrap;
    position: relative;
    overflow: hidden;
    z-index: 0;
    transition: box-shadow 0.3s cubic-bezier(0.23, 1, 0.32, 1), color 0.3s ease, border-color 0.3s ease;
  }

  .btn :global(svg) {
    flex-shrink: 0;
  }

  /* Круг растёт из точки в центре кнопки. Сторона квадрата = ширине кнопки
     (padding-bottom: 100% от width — классический CSS-приём получить квадрат
     от одной известной оси без JS) — работает на любом соотношении сторон,
     без подбора числа под конкретную кнопку (это и ломалось раньше: любое
     фиксированное значение рано или поздно не дотягивало на достаточно
     широкой кнопке). scale(0) стягивает круг в точку по центру. На hover —
     не scale(1): круг диаметром ровно в ширину кнопки покрывает середины
     боковых сторон, но не достаёт до дальних УГЛОВ прямоугольника (они
     дальше от центра на величину, зависящую от высоты) — 1.5 даёт запас
     с любой разумной высотой кнопки. */
  .btn::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    width: 100%;
    height: 0;
    padding-bottom: 100%;
    border-radius: 50%;
    scale: 0;
    z-index: -1;
    transition: scale 1.1s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .btn:hover::before {
    scale: 1.7;
  }

  @media (prefers-reduced-motion: reduce) {
    .btn,
    .btn::before {
      transition: none;
    }
  }

  .btn--m {
    padding: var(--space-16) var(--space-32);
  }

  .btn--l {
    padding: var(--space-20) var(--space-40);
  }

  .btn--primary {
    background: var(--color-accent-primary);
    color: var(--color-text-inverse);
  }

  .btn--primary::before {
    background-color: var(--color-accent-hover);
  }

  .btn--primary:hover {
    color: var(--color-text-inverse);
    box-shadow: 0 0 20px rgba(86, 99, 75, 0.4);
  }

  .btn--dark {
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
  }

  .btn--dark::before {
    background-color: var(--color-accent-primary);
  }

  .btn--dark:hover {
    color: var(--color-text-inverse);
    box-shadow: 0 0 20px rgba(86, 99, 75, 0.4);
  }

  .btn--outline {
    background: var(--color-bg-surface);
    color: var(--color-text-primary);
    border: 1px solid var(--color-border-default);
  }

  /* Заливка красит только рамку (stroke), не фон и не текст кнопки */
  .btn--outline::before {
    display: none;
  }

  .btn--outline:hover {
    border-color: var(--color-accent-primary);
  }

  .btn--soft {
    background: var(--color-accent-soft);
    color: var(--color-accent-primary);
  }

  .btn--soft::before {
    background-color: var(--color-accent-primary);
  }

  .btn--soft:hover {
    color: var(--color-text-inverse);
    box-shadow: 0 0 20px rgba(86, 99, 75, 0.4);
  }
</style>
