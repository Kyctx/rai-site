---
// Иконка из public/icons/*.svg. Обводка наследует цвет текста (stroke="currentColor" уже в файле).
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  name: string;
  size?: number;
  strokeWidth?: number;
  class?: string;
}

const { name, size = 24, strokeWidth, class: className } = Astro.props;

const filePath = path.resolve('public/icons', `${name}.svg`);
const raw = fs.existsSync(filePath) ? fs.readFileSync(filePath, 'utf-8') : '';
// Убираем фиксированные width/height из файла — размер задаём снаружи через проп.
let svg = raw
  .replace(/\swidth="[^"]*"/, '')
  .replace(/\sheight="[^"]*"/, '')
  .replace('<svg', `<svg width="${size}" height="${size}" aria-hidden="true" focusable="false"${className ? ` class="${className}"` : ''}`);

if (strokeWidth) {
  svg = svg.replace(/stroke-width="[^"]*"/g, `stroke-width="${strokeWidth}"`);
}
---

<Fragment set:html={svg} />
