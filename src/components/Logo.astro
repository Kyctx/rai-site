---
// Логотип «Рай»: графит + зелёный лист (public/icons/logo.svg), цвета зафиксированы по макету.
interface Props {
  width?: number;
  class?: string;
}

const { width = 53, class: className } = Astro.props;
const height = Math.round((width * 33) / 53);
const src = `${import.meta.env.BASE_URL.replace(/\/$/, '')}/icons/logo.svg`;
---

<img
  src={src}
  alt="Рай"
  width={width}
  height={height}
  class={className}
  loading="eager"
  decoding="async"
/>
